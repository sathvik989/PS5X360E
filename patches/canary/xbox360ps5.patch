+  dependencies[1].srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+  dependencies[1].dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+  VkRenderPassCreateInfo render_pass_info = {
+      VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+  render_pass_info.attachmentCount = 1;
+  render_pass_info.pAttachments = &attachment;
+  render_pass_info.subpassCount = 1;
+  render_pass_info.pSubpasses = &subpass;
+  render_pass_info.dependencyCount = 2;
+  render_pass_info.pDependencies = dependencies;
+  if (dfn.vkCreateRenderPass(device, &render_pass_info, nullptr,
+                             &smaa_.pass_rgba8) != VK_SUCCESS) {
+    return fail("the render pass");
+  }
+
+  // Pipelines.
+  for (size_t i = 0; i < 4; ++i) {
+    VkPipelineShaderStageCreateInfo stages[2] = {};
+    stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+    stages[0].module = smaa_.vs;
+    stages[0].pName = "main";
+    stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+    stages[1].module = smaa_.fs[i];
+    stages[1].pName = "main";
+    VkPipelineVertexInputStateCreateInfo vertex_input = {
+        VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+    VkPipelineInputAssemblyStateCreateInfo input_assembly = {
+        VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+    input_assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkPipelineViewportStateCreateInfo viewport = {
+        VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+    viewport.viewportCount = 1;
+    viewport.scissorCount = 1;
+    VkPipelineRasterizationStateCreateInfo rasterization = {
+        VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+    rasterization.polygonMode = VK_POLYGON_MODE_FILL;
+    rasterization.cullMode = VK_CULL_MODE_NONE;
+    rasterization.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    rasterization.lineWidth = 1.0f;
+    VkPipelineMultisampleStateCreateInfo multisample = {
+        VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+    multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineColorBlendAttachmentState blend_attachment = {};
+    blend_attachment.colorWriteMask =
+        VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+        VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
+    VkPipelineColorBlendStateCreateInfo blend = {
+        VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+    blend.attachmentCount = 1;
+    blend.pAttachments = &blend_attachment;
+    static constexpr VkDynamicState kDynamicStates[] = {
+        VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+    VkPipelineDynamicStateCreateInfo dynamic = {
+        VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+    dynamic.dynamicStateCount = uint32_t(xe::countof(kDynamicStates));
+    dynamic.pDynamicStates = kDynamicStates;
+    VkGraphicsPipelineCreateInfo pipeline_info = {
+        VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+    pipeline_info.stageCount = 2;
+    pipeline_info.pStages = stages;
+    pipeline_info.pVertexInputState = &vertex_input;
+    pipeline_info.pInputAssemblyState = &input_assembly;
+    pipeline_info.pViewportState = &viewport;
+    pipeline_info.pRasterizationState = &rasterization;
+    pipeline_info.pMultisampleState = &multisample;
+    pipeline_info.pColorBlendState = &blend;
+    pipeline_info.pDynamicState = &dynamic;
+    pipeline_info.layout = smaa_.pipeline_layout;
+    pipeline_info.renderPass =
+        i < 2 ? smaa_.pass_rgba8 : guest_output_intermediate_render_pass_;
+    pipeline_info.basePipelineIndex = -1;
+    if (dfn.vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                      &pipeline_info, nullptr,
+                                      &smaa_.pipelines[i]) != VK_SUCCESS) {
+      return fail("a pipeline");
+    }
+  }
+
+  // Lookup textures, uploaded by the first paint that uses them.
+  auto create_lookup = [&](VkFormat format, uint32_t width, uint32_t height,
+                           VkImage& image, VkDeviceMemory& memory,
+                           VkImageView& view) {
+    VkImageCreateInfo image_info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    image_info.imageType = VK_IMAGE_TYPE_2D;
+    image_info.format = format;
+    image_info.extent = {width, height, 1};
+    image_info.mipLevels = 1;
+    image_info.arrayLayers = 1;
+    image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image_info.usage =
+        VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (!util::CreateDedicatedAllocationImage(vulkan_device_, image_info,
+                                              util::MemoryPurpose::kDeviceLocal,
+                                              image, memory)) {
+      return false;
+    }
+    VkImageViewCreateInfo view_info = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    view_info.image = image;
+    view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    view_info.format = format;
+    view_info.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    return dfn.vkCreateImageView(device, &view_info, nullptr, &view) ==
+           VK_SUCCESS;
+  };
+  if (!create_lookup(VK_FORMAT_R8G8_UNORM, AREATEX_WIDTH, AREATEX_HEIGHT,
+                     smaa_.area_image, smaa_.area_memory, smaa_.area_view) ||
+      !create_lookup(VK_FORMAT_R8_UNORM, SEARCHTEX_WIDTH, SEARCHTEX_HEIGHT,
+                     smaa_.search_image, smaa_.search_memory,
+                     smaa_.search_view)) {
+    return fail("the lookup textures");
+  }
+  uint32_t upload_memory_type;
+  if (!util::CreateDedicatedAllocationBuffer(
+          vulkan_device_, AREATEX_SIZE + SEARCHTEX_SIZE,
+          VK_BUFFER_USAGE_TRANSFER_SRC_BIT, util::MemoryPurpose::kUpload,
+          smaa_.upload_buffer, smaa_.upload_memory, &upload_memory_type)) {
+    return fail("the lookup texture upload buffer");
+  }
+  void* mapping;
+  if (dfn.vkMapMemory(device, smaa_.upload_memory, 0, VK_WHOLE_SIZE, 0,
+                      &mapping) != VK_SUCCESS) {
+    return fail("the lookup texture upload mapping");
+  }
+  std::memcpy(mapping, shaders::areaTexBytes, AREATEX_SIZE);
+  std::memcpy(static_cast<uint8_t*>(mapping) + AREATEX_SIZE, shaders::searchTexBytes,
+              SEARCHTEX_SIZE);
+  util::FlushMappedMemoryRange(vulkan_device_, smaa_.upload_memory,
+                               upload_memory_type);
+  dfn.vkUnmapMemory(device, smaa_.upload_memory);
+
+  // Descriptors: edges and blend per paint reference, weights, and the output
+  // for the effects.
+  // Then FXAA's from the SMAA output and per paint reference.
+  const uint32_t own_sets = 3 * uint32_t(kSmaaSourceSlots) + 2;
+  // Output sets for the effects: SMAA's, the edges, FXAA's.
+  const uint32_t paint_sets = 3;
+  VkDescriptorPoolSize pool_sizes[2] = {
+      {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, own_sets * 3 + paint_sets},
+      {VK_DESCRIPTOR_TYPE_SAMPLER, own_sets * 2 + paint_sets}};
+  VkDescriptorPoolCreateInfo pool_info = {
+      VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+  pool_info.maxSets = own_sets + paint_sets;
+  pool_info.poolSizeCount = 2;
+  pool_info.pPoolSizes = pool_sizes;
+  if (dfn.vkCreateDescriptorPool(device, &pool_info, nullptr, &smaa_.pool) !=
+      VK_SUCCESS) {
+    return fail("the descriptor pool");
+  }
+  std::vector<VkDescriptorSetLayout> layouts(own_sets, smaa_.set_layout);
+  for (uint32_t i = 0; i < paint_sets; ++i) {
+    layouts.push_back(guest_output_paint_image_descriptor_set_layout_);
+  }
+  std::vector<VkDescriptorSet> sets(layouts.size());
+  VkDescriptorSetAllocateInfo allocate_info = {
+      VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+  allocate_info.descriptorPool = smaa_.pool;
+  allocate_info.descriptorSetCount = uint32_t(layouts.size());
+  allocate_info.pSetLayouts = layouts.data();
+  if (dfn.vkAllocateDescriptorSets(device, &allocate_info, sets.data()) !=
+      VK_SUCCESS) {
+    return fail("the descriptor sets");
+  }
+  for (size_t i = 0; i < kSmaaSourceSlots; ++i) {
+    smaa_.edges_sets[i] = sets[i];
+    smaa_.blend_sets[i] = sets[kSmaaSourceSlots + i];
+    smaa_.ref_dirty[i] = true;
+  }
+  smaa_.weights_set = sets[2 * kSmaaSourceSlots];
+  smaa_.fxaa_from_smaa_set = sets[2 * kSmaaSourceSlots + 1];
+  for (size_t i = 0; i < kSmaaSourceSlots; ++i) {
+    smaa_.fxaa_from_guest_sets[i] = sets[2 * kSmaaSourceSlots + 2 + i];
+  }
+  smaa_.output_set = sets[own_sets];
+  smaa_.edges_output_set = sets[own_sets + 1];
+  smaa_.fxaa_output_set = sets[own_sets + 2];
+
+  smaa_.ready = true;
+  XELOGW("SMAA: ready (high preset)");
+  return true;
+}
+
+void VulkanPresenter::DestroySmaaSized() {
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  util::DestroyAndNullHandle(dfn.vkDestroyFramebuffer, device,
+                             smaa_.edges_framebuffer);
+  util::DestroyAndNullHandle(dfn.vkDestroyFramebuffer, device,
+                             smaa_.weights_framebuffer);
+  util::DestroyAndNullHandle(dfn.vkDestroyFramebuffer, device,
+                             smaa_.output_framebuffer);
+  util::DestroyAndNullHandle(dfn.vkDestroyFramebuffer, device,
+                             smaa_.fxaa_framebuffer);
+  util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, smaa_.edges_view);
+  util::DestroyAndNullHandle(dfn.vkDestroyImageView, device,
+                             smaa_.weights_view);
+  util::DestroyAndNullHandle(dfn.vkDestroyImage, device, smaa_.edges_image);
+  util::DestroyAndNullHandle(dfn.vkDestroyImage, device, smaa_.weights_image);
+  util::DestroyAndNullHandle(dfn.vkFreeMemory, device, smaa_.edges_memory);
+  util::DestroyAndNullHandle(dfn.vkFreeMemory, device, smaa_.weights_memory);
+  smaa_.output.reset();
+  smaa_.fxaa_output.reset();
+  smaa_.extent = {};
+}
+
+void VulkanPresenter::DestroySmaa() {
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  DestroySmaaSized();
+  util::DestroyAndNullHandle(dfn.vkDestroyDescriptorPool, device, smaa_.pool);
+  util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, smaa_.upload_buffer);
+  util::DestroyAndNullHandle(dfn.vkFreeMemory, device, smaa_.upload_memory);
+  util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, smaa_.area_view);
+  util::DestroyAndNullHandle(dfn.vkDestroyImageView, device,
+                             smaa_.search_view);
+  util::DestroyAndNullHandle(dfn.vkDestroyImage, device, smaa_.area_image);
+  util::DestroyAndNullHandle(dfn.vkDestroyImage, device, smaa_.search_image);
+  util::DestroyAndNullHandle(dfn.vkFreeMemory, device, smaa_.area_memory);
+  util::DestroyAndNullHandle(dfn.vkFreeMemory, device, smaa_.search_memory);
+  for (VkPipeline& pipeline : smaa_.pipelines) {
+    util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device, pipeline);
+  }
+  util::DestroyAndNullHandle(dfn.vkDestroyRenderPass, device, smaa_.pass_rgba8);
+  for (VkShaderModule& module : smaa_.fs) {
+    util::DestroyAndNullHandle(dfn.vkDestroyShaderModule, device, module);
+  }
+  util::DestroyAndNullHandle(dfn.vkDestroyShaderModule, device, smaa_.vs);
+  util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device,
+                             smaa_.pipeline_layout);
+  util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout, device,
+                             smaa_.set_layout);
+  smaa_ = Smaa();
+}
+
+VkDescriptorSet VulkanPresenter::PaintSmaa(
+    VkCommandBuffer command_buffer, size_t paint_ref_index,
+    VkImageView source_view, VkImageLayout source_layout, VkExtent2D extent,
+    uint64_t submission_index, bool smaa, bool fxaa, bool show_edges) {
+  if ((!smaa && !fxaa) || !InitializeSmaa()) {
+    return VK_NULL_HANDLE;
+  }
+  show_edges = show_edges && smaa;
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+
+  // Images sized like the guest output.
+  if (smaa_.extent.width != extent.width ||
+      smaa_.extent.height != extent.height) {
+    paint_context_.completion_timeline.AwaitSubmissionAndUpdateCompleted(
+        smaa_.last_submission);
+    DestroySmaaSized();
+    auto create_target = [&](VkImage& image, VkDeviceMemory& memory,
+                             VkImageView& view) {
+      VkImageCreateInfo image_info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+      image_info.imageType = VK_IMAGE_TYPE_2D;
+      image_info.format = VK_FORMAT_R8G8B8A8_UNORM;
+      image_info.extent = {extent.width, extent.height, 1};
+      image_info.mipLevels = 1;
+      image_info.arrayLayers = 1;
+      image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+      image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+      image_info.usage =
+          VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+      image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+      image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      if (!util::CreateDedicatedAllocationImage(
+              vulkan_device_, image_info, util::MemoryPurpose::kDeviceLocal,
+              image, memory)) {
+        return false;
+      }
+      VkImageViewCreateInfo view_info = {
+          VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+      view_info.image = image;
+      view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view_info.format = VK_FORMAT_R8G8B8A8_UNORM;
+      view_info.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+      return dfn.vkCreateImageView(device, &view_info, nullptr, &view) ==
+             VK_SUCCESS;
+    };
+    auto create_framebuffer = [&](VkRenderPass render_pass, VkImageView view,
+                                  VkFramebuffer& framebuffer) {
+      VkFramebufferCreateInfo framebuffer_info = {
+          VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+      framebuffer_info.renderPass = render_pass;
+      framebuffer_info.attachmentCount = 1;
+      framebuffer_info.pAttachments = &view;
+      framebuffer_info.width = extent.width;
+      framebuffer_info.height = extent.height;
+      framebuffer_info.layers = 1;
+      return dfn.vkCreateFramebuffer(device, &framebuffer_info, nullptr,
+                                     &framebuffer) == VK_SUCCESS;
+    };
+    if (!create_target(smaa_.edges_image, smaa_.edges_memory,
+                       smaa_.edges_view) ||
+        !create_target(smaa_.weights_image, smaa_.weights_memory,
+                       smaa_.weights_view) ||
+        !(smaa_.output = GuestOutputImage::Create(vulkan_device_, extent.width,
+                                                  extent.height)) ||
+        !create_framebuffer(smaa_.pass_rgba8, smaa_.edges_view,
+                            smaa_.edges_framebuffer) ||
+        !create_framebuffer(smaa_.pass_rgba8, smaa_.weights_view,
+                            smaa_.weights_framebuffer) ||
+        !create_framebuffer(guest_output_intermediate_render_pass_,
+                            smaa_.output->view(), smaa_.output_framebuffer) ||
+        !(smaa_.fxaa_output = GuestOutputImage::Create(
+              vulkan_device_, extent.width, extent.height)) ||
+        !create_framebuffer(guest_output_intermediate_render_pass_,
+                            smaa_.fxaa_output->view(),
+                            smaa_.fxaa_framebuffer)) {
+      XELOGE("SMAA: failed to create the {}x{} images", extent.width,
+             extent.height);
+      DestroySmaaSized();
+      return VK_NULL_HANDLE;
+    }
+    smaa_.extent = extent;
+    // Everything referring to the sized images: none is in use after the wait.
+    VkDescriptorImageInfo images[5] = {};
+    for (VkDescriptorImageInfo& image : images) {
+      image.imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    }
+    images[0].imageView = smaa_.edges_view;
+    images[1].imageView = smaa_.area_view;
+    images[2].imageView = smaa_.search_view;
+    images[3].imageView = smaa_.output->view();
+    images[4].imageView = smaa_.fxaa_output->view();
+    std::vector<VkWriteDescriptorSet> writes;
+    VkWriteDescriptorSet write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.descriptorCount = 3;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    write.dstSet = smaa_.weights_set;
+    write.dstBinding = 0;
+    write.pImageInfo = &images[0];
+    writes.push_back(write);
+    write.descriptorCount = 1;
+    write.dstSet = smaa_.output_set;
+    write.pImageInfo = &images[3];
+    writes.push_back(write);
+    write.dstSet = smaa_.edges_output_set;
+    write.pImageInfo = &images[0];
+    writes.push_back(write);
+    write.dstSet = smaa_.fxaa_from_smaa_set;
+    write.pImageInfo = &images[3];
+    writes.push_back(write);
+    write.dstSet = smaa_.fxaa_output_set;
+    write.pImageInfo = &images[4];
+    writes.push_back(write);
+    dfn.vkUpdateDescriptorSets(device, uint32_t(writes.size()), writes.data(),
+                               0, nullptr);
+    smaa_.ref_dirty.fill(true);
+  }
+
+  // The guest output of this paint reference, and the weights.
+  if (smaa_.ref_dirty[paint_ref_index] ||
+      smaa_.ref_views[paint_ref_index] != source_view ||
+      smaa_.ref_layouts[paint_ref_index] != source_layout) {
+    smaa_.ref_dirty[paint_ref_index] = false;
+    smaa_.ref_views[paint_ref_index] = source_view;
+    smaa_.ref_layouts[paint_ref_index] = source_layout;
+    VkDescriptorImageInfo edges_images[3] = {}, blend_images[3] = {};
+    for (size_t i = 0; i < 3; ++i) {
+      edges_images[i].imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+      blend_images[i].imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    }
+    edges_images[0].imageView = source_view;
+    edges_images[0].imageLayout = source_layout;
+    edges_images[1].imageView = smaa_.area_view;
+    edges_images[2].imageView = smaa_.search_view;
+    blend_images[0].imageView = source_view;
+    blend_images[0].imageLayout = source_layout;
+    blend_images[1].imageView = smaa_.weights_view;
+    blend_images[2].imageView = smaa_.search_view;
+    VkWriteDescriptorSet writes[3] = {};
+    for (size_t i = 0; i < 3; ++i) {
+      writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+      writes[i].descriptorCount = 3;
+      writes[i].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    }
+    writes[0].dstSet = smaa_.edges_sets[paint_ref_index];
+    writes[0].pImageInfo = edges_images;
+    writes[1].dstSet = smaa_.blend_sets[paint_ref_index];
+    writes[1].pImageInfo = blend_images;
+    // FXAA reads binding 0 only.
+    writes[2].dstSet = smaa_.fxaa_from_guest_sets[paint_ref_index];
+    writes[2].descriptorCount = 1;
+    writes[2].pImageInfo = edges_images;
+    dfn.vkUpdateDescriptorSets(device, 3, writes, 0, nullptr);
+  }
+
+  // The lookup textures, once.
+  if (!smaa_.lookup_uploaded) {
+    smaa_.lookup_uploaded = true;
+    VkImageMemoryBarrier barriers[2] = {};
+    for (size_t i = 0; i < 2; ++i) {
+      barriers[i].sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+      barriers[i].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barriers[i].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barriers[i].subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+      barriers[i].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      barriers[i].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+      barriers[i].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    }
+    barriers[0].image = smaa_.area_image;
+    barriers[1].image = smaa_.search_image;
+    dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                             VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                             nullptr, 2, barriers);
+    VkBufferImageCopy copy = {};
+    copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    copy.imageExtent = {AREATEX_WIDTH, AREATEX_HEIGHT, 1};
+    dfn.vkCmdCopyBufferToImage(command_buffer, smaa_.upload_buffer,
+                               smaa_.area_image,
+                               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+    copy.bufferOffset = AREATEX_SIZE;
+    copy.imageExtent = {SEARCHTEX_WIDTH, SEARCHTEX_HEIGHT, 1};
+    dfn.vkCmdCopyBufferToImage(command_buffer, smaa_.upload_buffer,
+                               smaa_.search_image,
+                               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+    for (size_t i = 0; i < 2; ++i) {
+      barriers[i].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+      barriers[i].newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+      barriers[i].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+      barriers[i].dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    }
+    dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 0,
+                             nullptr, 0, nullptr, 2, barriers);
+  }
+
+  // The three passes.
+  const float metrics[4] = {1.0f / float(extent.width),
+                            1.0f / float(extent.height), float(extent.width),
+                            float(extent.height)};
+  VkViewport viewport = {0.0f, 0.0f, float(extent.width),
+                         float(extent.height), 0.0f, 1.0f};
+  VkRect2D scissor = {{0, 0}, extent};
+  VkClearValue clear = {};
+  const VkFramebuffer framebuffers[4] = {
+      smaa_.edges_framebuffer, smaa_.weights_framebuffer,
+      smaa_.output_framebuffer, smaa_.fxaa_framebuffer};
+  const VkDescriptorSet sets[4] = {
+      smaa_.edges_sets[paint_ref_index], smaa_.weights_set,
+      smaa_.blend_sets[paint_ref_index],
+      smaa ? smaa_.fxaa_from_smaa_set
+           : smaa_.fxaa_from_guest_sets[paint_ref_index]};
+  // SMAA's passes (edges only, to show them), then FXAA.
+  for (size_t i = smaa ? 0 : 3; i < 4; ++i) {
+    if (i < 3 ? (i == 2 && show_edges) : (!fxaa || show_edges)) {
+      continue;
+    }
+    VkRenderPassBeginInfo begin = {VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    begin.renderPass =
+        i < 2 ? smaa_.pass_rgba8 : guest_output_intermediate_render_pass_;
+    begin.framebuffer = framebuffers[i];
+    begin.renderArea = scissor;
+    begin.clearValueCount = i < 2 ? 1 : 0;
+    begin.pClearValues = i < 2 ? &clear : nullptr;
+    dfn.vkCmdBeginRenderPass(command_buffer, &begin,
+                             VK_SUBPASS_CONTENTS_INLINE);
+    dfn.vkCmdSetViewport(command_buffer, 0, 1, &viewport);
+    dfn.vkCmdSetScissor(command_buffer, 0, 1, &scissor);
+    dfn.vkCmdBindPipeline(command_buffer, VK_PIPELINE_BIND_POINT_GRAPHICS,
+                          smaa_.pipelines[i]);
+    dfn.vkCmdBindDescriptorSets(command_buffer, VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                smaa_.pipeline_layout, 0, 1, &sets[i], 0,
+                                nullptr);
+    dfn.vkCmdPushConstants(command_buffer, smaa_.pipeline_layout,
+                           VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(metrics),
+                           metrics);
+    dfn.vkCmdDraw(command_buffer, 3, 1, 0, 0);
+    dfn.vkCmdEndRenderPass(command_buffer);
+  }
+  smaa_.last_submission = submission_index;
+  if (smaa && show_edges) {
+    return smaa_.edges_output_set;
+  }
+  return fxaa ? smaa_.fxaa_output_set : smaa_.output_set;
+}
+
 }  // namespace vulkan
 }  // namespace ui
 }  // namespace xe
