+void ShutdownCameraDevice() {
+  std::unique_ptr<CameraDevice> camera_device;
+  {
+    std::lock_guard<xe_mutex> lock(g_camera_device_mutex);
+    camera_device = std::move(g_camera_device);
+  }
+  // Destroyed unlocked, as its worker may still be completing a request.
+  camera_device.reset();
+  {
+    std::lock_guard<std::mutex> lock(g_skeleton_source.mutex);
+    g_skeleton_source.start = std::chrono::steady_clock::now();
+    g_skeleton_source.delivered_period = 0;
+    g_skeleton_source.identity = {};
+    g_skeleton_source.notified_callback = 0;
+    g_skeleton_source.notified_tracking_id = 0;
+    g_skeleton_source.notified_user = xbox360ps5::motion::kUserIndexNone;
+  }
+  g_skeleton_binding_tried = false;
+  xbox360ps5::motion::guest_skeleton_bound = false;
+  xbox360ps5::motion::guest_skeleton_frames = 0;
+  xbox360ps5::motion::guest_skeleton_bodies = 0;
+  xbox360ps5::motion::ResetVirtualNui();
+}
