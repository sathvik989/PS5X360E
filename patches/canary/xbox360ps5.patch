+// Xbox360PS5: skeleton frames for the title, from the estimated pose.
+// The title's NUI library finds bodies with GPU passes that end in copy
+// commands the emulator does not have (copy command 2 and whole lists of
+// rectangles), so the frames it builds never hold a body, whatever the depth
+// picture shows. The title's NuiSkeletonGetNextFrame is answered here instead,
+// one frame per sensor period.
+constexpr uint32_t kSkeletonPeriodMs = 33;
+// The library's own limit for a wait.
+constexpr uint32_t kSkeletonLongestWaitMs = 8000;
+constexpr X_HRESULT kSkeletonInvalidArgument = 0x80070057;
+// What the library returns when its wait for a frame ends without one.
+constexpr X_HRESULT kSkeletonNoFrameYet = 0x8000000A;
+constexpr X_HRESULT kSkeletonNotConnected = 0x8007048F;
+
+struct SkeletonSource {
+  std::mutex mutex;
+  std::chrono::steady_clock::time_point start =
+      std::chrono::steady_clock::now();
+  uint32_t delivered_period = 0;
+  // Names the body in the frames. A body that comes back after being lost is
+  // a new one for the title, as with the sensor.
+  xbox360ps5::motion::SkeletonIdentity identity;
+  uint32_t notified_callback = 0, notified_tracking_id = 0;
+  uint32_t notified_user = xbox360ps5::motion::kUserIndexNone;
+};
+SkeletonSource g_skeleton_source;
+std::atomic<bool> g_skeleton_binding_tried{false};
+
+// Targeted estimated hand reach fallback. Keep the title's own direction
+// thresholds, 15-update debounce, edge creation and menu consumers intact.
+// This substitutes missing image-derived hand reach, not controller buttons.
+void EstimatedHandsHandler(cpu::ppc::PPCContext* context, KernelState* kernel) {
+  context->r[11] = 0xFFFFFFFF820E0000ull;  // replaced lis r11,0x820E
+  const uint32_t object = uint32_t(context->r[30]);
+  Memory* memory = kernel->memory();
+  if (kernel->title_id() != xbox360ps5::motion::kVirtualNuiTitle ||
+      !object || uint64_t(object) + 0x2740 > 0x100000000ull ||
+      !IsGuestRangeMapped(memory, object + 0x1D80 + 0x5F8, 4, false) ||
+      !IsGuestRangeMapped(memory, object + 0x2710, 0x78, true)) return;
+  const auto* unavailable = memory->TranslateVirtual(object + 0x1D80 + 0x5F8);
+  if (xe::load_and_swap<uint32_t>(unavailable) == 0) return;
+  auto pose = xbox360ps5::motion::Snapshot();
+  uint32_t signed_in_mask = 0;
+  for (uint32_t slot = 0; slot < 4; ++slot) {
+    if (kernel->xam_state()->IsUserSignedIn(slot) &&
+        kernel->xam_state()->GetUserProfile(slot)) signed_in_mask |= 1u << slot;
+  }
+  const auto binding = xbox360ps5::motion::LiveNuiBinding(kernel->title_id(), signed_in_mask);
+  if (!binding.tracking_id || binding.session != pose.session ||
+      !IsGuestRangeMapped(memory, object + 0xB4, 4, false) ||
+      xe::load_and_swap<uint32_t>(memory->TranslateVirtual(object + 0xB4)) != binding.tracking_id) pose = {};
+  const auto hands = xbox360ps5::motion::EstimateHands(pose);
+  const xbox360ps5::motion::EstimatedHand values[] = {hands.right, hands.left};
+  auto* output = memory->TranslateVirtual(object);
+  // Observe the PREVIOUS original title update, not synthetic direction bits.
+  // A bounded count keeps these diagnostics cheap during a long play session.
+  static thread_local unsigned edge_reports = 0;
+  const uint32_t right_edge = xe::load_and_swap<uint32_t>(output + 0x2780);
+  const uint32_t left_edge = xe::load_and_swap<uint32_t>(output + 0x2784);
+  if ((right_edge || left_edge) && edge_reports < 32) {
+    ++edge_reports;
+    XELOGW("Virtual Kinect menu: original direction edges {:08X}/{:08X}, held {:08X}/{:08X}",
+           right_edge, left_edge,
+           xe::load_and_swap<uint32_t>(output + 0x2778),
+           xe::load_and_swap<uint32_t>(output + 0x277C));
+  }
+  for (size_t n = 0; n < 2; ++n) {
+    const auto& hand = values[n];
+    xe::store_and_swap<float>(output + 0x2710 + n * 4, hand.magnitude);
+    xbox360ps5::motion::StoreVector(output + 0x2720 + n * 16,
+                                   hand.vector.x, hand.vector.y, hand.vector.z, 0);
+    xe::store_and_swap<float>(output + 0x2740 + n * 8, hand.cursor_x);
+    xe::store_and_swap<float>(output + 0x2744 + n * 8, hand.cursor_y);
+  }
+}
+
+void BindEstimatedHands(KernelState* kernel, cpu::XexModule* xex) {
+  constexpr uint32_t site = 0x821B4E24;
+  constexpr std::string_view name = "ps5x360-estimated-hands";
+  Memory* memory = kernel->memory();
+  auto* processor = kernel->processor();
+  if (processor->GetModule(name)) return;
+  if (!IsGuestRangeMapped(memory, site, 4, false) ||
+      xe::load_and_swap<uint32_t>(memory->TranslateVirtual(site)) != 0x3D60820E ||
+      !processor->FindFunctionsWithAddress(site).empty()) {
+    XELOGW("Virtual Kinect: hand reach seam is unavailable or already compiled");
+    return;
+  }
+  // A new owned guest page, within the PPC relative branch reach. Never borrow
+  // padding from the executable or overwrite an existing guest allocation.
+  auto* heap = memory->LookupHeap(0x83C00000);
+  uint32_t shim = 0;
+  if (!heap || !heap->AllocRange(0x83C00000, 0x83FFFFFF, 4096, 4096,
+          kMemoryAllocationReserve | kMemoryAllocationCommit,
+          kMemoryProtectRead | kMemoryProtectWrite, false, &shim)) return;
+  const int64_t delta = int64_t(shim) - site;
+  if (delta < -0x2000000 || delta > 0x1FFFFFC || (delta & 3)) {
+    heap->Release(shim);
+    return;
+  }
+  auto raw = std::make_unique<cpu::RawModule>(processor);
+  raw->set_name(name);
+  raw->SetAddressRange(shim, 4096);
+  cpu::Function* function = nullptr;
+  const auto status = raw->DeclareFunction(shim, &function);
+  auto* code_heap = memory->LookupHeap(site);
+  uint32_t protection = 0;
+  if (!function || status != cpu::Symbol::Status::kNew || !code_heap ||
+      !code_heap->QueryProtect(site, &protection) ||
+      !code_heap->Protect(site, 4, kMemoryProtectRead | kMemoryProtectWrite)) {
+    heap->Release(shim);
+    return;
+  }
+  static_cast<cpu::GuestFunction*>(function)->SetupExtern(EstimatedHandsHandler);
+  function->set_end_address(shim + 4);
+  function->set_status(cpu::Symbol::Status::kDeclared);
+  xe::store_and_swap<uint32_t>(memory->TranslateVirtual(shim), 0x44000042);
+  xe::store_and_swap<uint32_t>(memory->TranslateVirtual(shim + 4), 0x4E800020);
+  if (!processor->AddModule(std::move(raw))) {
+    code_heap->Protect(site, 4, protection);
+    heap->Release(shim);
+    return;
+  }
+  xe::store_and_swap<uint32_t>(memory->TranslateVirtual(site),
+                             0x48000001 | (uint32_t(delta) & 0x03FFFFFC));
+  if (!code_heap->Protect(site, 4, protection)) {
+    XELOGE("Virtual Kinect: hand seam installed but code protection restore failed");
+    return;
+  }
+  // The raw module lives with the processor, including after camera stop.
+  // Its disabled handler clears reach and still emulates the original lis.
+  XELOGW("Virtual Kinect: estimated hand reach fallback bound at {:08X} via {:08X}; native menu debounce retained",
+         site, shim);
+  (void)xex;
+}
+
+X_HRESULT SkeletonGetNextFrame(KernelState* kernel_state, uint32_t wait_ms,
+                               uint32_t frame_ptr) {
+  using clock = std::chrono::steady_clock;
+  if (!xbox360ps5::motion::enabled.load()) return kSkeletonNotConnected;
+  Memory* memory = kernel_state->memory();
+  if (!IsGuestRangeMapped(memory, frame_ptr,
+                          xbox360ps5::motion::kSkeletonFrameBytes, true)) {
+    return kSkeletonInvalidArgument;
+  }
+  SkeletonSource& source = g_skeleton_source;
+  const auto period_now = [&source] {
+    return uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                        clock::now() - source.start)
+                        .count() /
+                    kSkeletonPeriodMs) +
+           1;
+  };
+  const auto deadline =
+      clock::now() + std::chrono::milliseconds(
+                         std::min(wait_ms, kSkeletonLongestWaitMs));
+  std::unique_lock<std::mutex> lock(source.mutex);
+  uint32_t period = period_now();
+  // A second request within one period waits for the next frame.
+  while (period == source.delivered_period) {
+    if (!xbox360ps5::motion::enabled.load()) return kSkeletonNotConnected;
+    if (clock::now() >= deadline) {
+      return kSkeletonNoFrameYet;
+    }
+    lock.unlock();
+    xe::threading::Sleep(std::chrono::milliseconds(1));
+    lock.lock();
+    period = period_now();
+  }
+  if (!xbox360ps5::motion::enabled.load()) return kSkeletonNotConnected;
+  source.delivered_period = period;
+  const xbox360ps5::motion::Frame pose = xbox360ps5::motion::Snapshot();
+  const uint32_t tracking_id = source.identity.Update(pose);
+  uint32_t signed_in_mask = 0;
+  for (uint32_t slot = 0; slot < 4; ++slot) {
+    if (kernel_state->xam_state()->IsUserSignedIn(slot) &&
+        kernel_state->xam_state()->GetUserProfile(slot))
+      signed_in_mask |= 1u << slot;
+  }
+  const auto binding = xbox360ps5::motion::PublishNuiFrame(
+      pose, tracking_id, signed_in_mask);
+  xbox360ps5::motion::WriteSkeletonFrame(
+      memory->TranslateVirtual(frame_ptr), pose, period,
+      uint64_t(period) * kSkeletonPeriodMs,
+      tracking_id, binding.enrollment, binding.user_index);
+  ++xbox360ps5::motion::guest_skeleton_frames;
+  if (pose.tracked) {
+    ++xbox360ps5::motion::guest_skeleton_bodies;
+  }
+  const uint32_t callback = xbox360ps5::motion::nui_identity_callback.load();
+  const bool notify = callback &&
+      (callback != source.notified_callback ||
+       binding.tracking_id != source.notified_tracking_id ||
+       binding.user_index != source.notified_user);
+  if (notify) {
+    source.notified_callback = callback;
+    source.notified_tracking_id = binding.tracking_id;
+    source.notified_user = binding.user_index;
+  }
+  // The verified callback case 2C00F at 8249D2C0 calls the SDK user-map
+  // refresh (8249D0E0) without dereferencing r4. Invoke outside our mutex:
+  // that refresh queries XamUserNuiGetUserIndex and may take guest locks.
+  lock.unlock();
+  if (notify && xbox360ps5::motion::enabled.load() &&
+      IsGuestRangeMapped(memory, callback, 4, false)) {
+    auto* thread = cpu::ThreadState::Get();
+    if (thread) {
+      uint64_t args[] = {0x0002C00F, 0};
+      kernel_state->processor()->Execute(thread, callback, args, 2);
+      ++xbox360ps5::motion::nui_identity_notifications;
+    }
+  }
+  return X_E_SUCCESS;
+}
+
+void SkeletonGetNextFrameHandler(cpu::ppc::PPCContext* ppc_context,
+                                 KernelState* kernel_state) {
+  const uint32_t frame = uint32_t(ppc_context->r[4]);
+  ppc_context->r[3] = uint32_t(SkeletonGetNextFrame(
+      kernel_state, uint32_t(ppc_context->r[3]), frame));
+  // Reviewed DBZ caller embeds its frame at object+80. Observe the previous
+  // update without changing guest state. The hand context is separate from
+  // the raised-hand prompt; a delivered skeleton is not proof it is usable.
+  if (ppc_context->r[3] == X_E_SUCCESS &&
+      uint32_t(ppc_context->lr) == 0x821B51D0 && frame >= 0x80 &&
+      xbox360ps5::motion::guest_skeleton_frames.load() % 150 == 0) {
+    const uint32_t object = frame - 0x80;
+    Memory* memory = kernel_state->memory();
+    if (uint64_t(object) + 0x2788 <= 0x100000000ull &&
+        IsGuestRangeMapped(memory, object, 0x2788, false)) {
+      const auto* data = memory->TranslateVirtual(object);
+      auto u32 = [data](size_t at) { return xe::load_and_swap<uint32_t>(data + at); };
+      auto f32 = [data](size_t at) { return xe::load_and_swap<float>(data + at); };
+      XELOGW("Virtual Kinect hands: context unavailable {} magnitude {}/{} "
+             "vectors ({},{},{})/({},{},{}) edges {:08X}/{:08X}",
+             u32(0x1D80 + 0x5F8), f32(0x2710), f32(0x2714),
+             f32(0x2720), f32(0x2724), f32(0x2728),
+             f32(0x2730), f32(0x2734), f32(0x2738),
+             u32(0x2780), u32(0x2784));
+#if !XE_PLATFORM_PS5
+      // Explicit one-shot HOST investigation: replay the reviewed SDK feed
+      // with the current frame to inspect its HRESULT. Never run on PS5.
+      static bool hand_probe_done = false;
+      if (!hand_probe_done && std::getenv("XBOX360PS5_NUI_HAND_PROBE")) {
+        hand_probe_done = true;
+        const uint64_t a = (uint64_t(u32(0x30)) + 6) * 4;
+        const uint64_t b = (uint64_t(u32(0x50)) + 14) * 4;
+        if (a + 4 <= 0x2788 && b + 4 <= 0x2788) {
+          const uint32_t first = u32(size_t(a)), second = u32(size_t(b));
+          XELOGW("Virtual Kinect hand probe: image indices {}/{} slots {}/{} pointers {:08X}/{:08X}",
+                 u32(0x30), u32(0x50), a, b, first, second);
+          auto* thread = cpu::ThreadState::Get();
+          if (thread && first && IsGuestRangeMapped(memory, first, 0x18, false)) {
+            const auto* descriptor = memory->TranslateVirtual(first);
+            XELOGW("Virtual Kinect hand probe: image {:08X} type {} resource {:08X} optional {:08X}",
+                   first, xe::load_and_swap<uint32_t>(descriptor + 0x10),
+                   xe::load_and_swap<uint32_t>(descriptor + 0x14), second);
+            uint64_t args[] = {object + 0x1D80, 0, frame, first, 0, second, 0};
+            const auto result = kernel_state->processor()->Execute(thread, 0x824FFCA8, args, 7);
+            XELOGW("Virtual Kinect hand probe: SDK feed {:08X}, unavailable {} body state {}",
+                   uint32_t(result), u32(0x1D80 + 0x5F8), u32(0x80 + 0x30));
+          }
+        }
+      }
+#endif
+    }
+  }
+}
+
+// Finds the title's NuiSkeletonGetNextFrame and has the guest run the handler
+// above in its place, the way an import is bound: "sc 2; blr" at its start and
+// an extern handler on the function. Done once, at the title's first camera
+// request, which is before it can have asked for a skeleton frame.
+void BindSkeletonSource(KernelState* kernel_state) {
+  // The frame ABI has only been traced for this title. Optional Kinect games
+  // must retain their own SDK even if motion is enabled globally.
+  if (kernel_state->title_id() != 0x4E4D084E) return;
+  if (g_skeleton_binding_tried.exchange(true)) {
+    return;
+  }
+  auto module = kernel_state->GetExecutableModule();
+  // Enrollment and identity callback contracts were traced in this image.
+  if (!module || module->hash() != 0x8FDD4F4AB147612Aull) return;
+  cpu::XexModule* xex = module ? module->xex_module() : nullptr;
+  if (!xex) {
+    return;
+  }
+  Memory* memory = kernel_state->memory();
+  const uint32_t base = xex->base_address();
+  const uint32_t size = xex->image_size();
+  if (!IsGuestRangeMapped(memory, base, size, false)) {
+    XELOGW("Virtual Kinect: the title's image is not all readable; its own "
+           "body tracking is kept");
+    return;
+  }
+  const std::vector<uint32_t> found =
+      xbox360ps5::motion::FindSkeletonGetNextFrame(
+          memory->TranslateVirtual(base), size, base);
+  if (found.size() != 1) {
+    XELOGW("Virtual Kinect: the skeleton frame function was not identified "
+           "({} candidates); the title keeps its own body tracking",
+           found.size());
+    return;
+  }
+  const uint32_t address = found[0];
+  cpu::Function* function = nullptr;
+  const cpu::Symbol::Status status = xex->DeclareFunction(address, &function);
+  if (!function || (status != cpu::Symbol::Status::kNew &&
+                    status != cpu::Symbol::Status::kDeclared)) {
+    XELOGW("Virtual Kinect: the skeleton frame function at {:08X} is already "
+           "compiled; the title keeps its own body tracking",
+           address);
+    return;
+  }
+  auto* heap = memory->LookupHeap(address);
+  uint32_t protection = 0;
+  const bool writable =
+      heap && heap->QueryProtect(address, &protection) &&
+      heap->Protect(address, 8, kMemoryProtectRead | kMemoryProtectWrite);
+  if (writable) {
+    // The handler is in place before the code that calls it can be compiled.
+    static_cast<cpu::GuestFunction*>(function)->SetupExtern(
+        SkeletonGetNextFrameHandler);
+    uint8_t* code = memory->TranslateVirtual(address);
+    xe::store_and_swap<uint32_t>(code + 0, 0x44000042);  // sc 2
+    xe::store_and_swap<uint32_t>(code + 4, 0x4E800020);  // blr
+    heap->Protect(address, 8, protection);
+    function->set_end_address(address + 4);
+  }
+  if (status == cpu::Symbol::Status::kNew) {
+    function->set_status(cpu::Symbol::Status::kDeclared);
+  }
+  if (!writable) {
+    XELOGW("Virtual Kinect: the skeleton frame function at {:08X} could not "
+           "be bound; the title keeps its own body tracking",
+           address);
+    return;
+  }
+  xbox360ps5::motion::guest_skeleton_bound = true;
+  BindEstimatedHands(kernel_state, xex);
+  XELOGW("Virtual Kinect: skeleton frames of the title come from the "
+         "estimated pose (function at {:08X})",
+         address);
+}
