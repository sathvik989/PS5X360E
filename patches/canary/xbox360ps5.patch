+void CommandProcessor::DiagNoteCopyback(const char* what, uint32_t address,
+                                      uint32_t length) {
+  const uint32_t block = diag_wait_block_.load(std::memory_order_relaxed);
+  if (!block || !length || address >= ((block & ~0xFFFu) + 0x1000) ||
+      uint64_t(address) + length <= (block & ~0xFFFu)) {
+    return;
+  }
+  if (diag_copyback_logs_.fetch_add(1, std::memory_order_relaxed) < 32) {
+    XELOGW("GPU: {} 0x{:08X}+0x{:X} overwrites guest RAM in the page of the "
+           "WAIT_REG_MEM marker 0x{:08X}",
+           what, address, length, block);
+  }
+}
+
+void CommandProcessor::DiagWalk(const char* what, const uint8_t* buffer,
+                                uint32_t capacity, uint32_t read,
+                                uint32_t write) {
+  if (!buffer || !capacity) {
+    return;
+  }
+  auto at = [&](uint32_t offset) {
+    return xe::load_and_swap<uint32_t>(buffer + (offset % capacity));
+  };
+  const uint32_t available = (write + capacity - read) % capacity;
+  XELOGW("GPU: ahead in the {}: {} dwords", what, available / 4);
+  uint32_t offset = 0;
+  for (uint32_t n = 0; n < 48 && offset + 4 <= available; ++n) {
+    const uint32_t header = at(read + offset);
+    uint32_t count = 1;
+    switch (header >> 30) {
+      case 0:
+        count = ((header >> 16) & 0x3FFF) + 1;
+        XELOGW("GPU:   +{:04X} REGS 0x{:04X} n{} {:08X} {:08X}", offset / 4,
+               header & 0x7FFF, count, at(read + offset + 4),
+               count > 1 ? at(read + offset + 8) : 0);
+        break;
+      case 1:
+        count = 2;
+        XELOGW("GPU:   +{:04X} REG2 0x{:04X}={:08X} 0x{:04X}={:08X}",
+               offset / 4, header & 0x7FF, at(read + offset + 4),
+               (header >> 11) & 0x7FF, at(read + offset + 8));
+        break;
+      case 2:
+        count = 0;
+        XELOGW("GPU:   +{:04X} NOP", offset / 4);
+        break;
+      case 3:
+        count = ((header >> 16) & 0x3FFF) + 1;
+        XELOGW("GPU:   +{:04X} op {:02X} n{} {:08X} {:08X} {:08X}", offset / 4,
+               (header >> 8) & 0x7F, count, at(read + offset + 4),
+               count > 1 ? at(read + offset + 8) : 0,
+               count > 2 ? at(read + offset + 12) : 0);
+        break;
+    }
+    offset += (count + 1) * 4;
+  }
+}
+
+void CommandProcessor::DiagSetPhase(DiagPhase phase) {
+  if (diag_phase_.load(std::memory_order_relaxed) == uint32_t(phase)) {
+    return;
+  }
+  diag_phase_.store(uint32_t(phase), std::memory_order_relaxed);
+  diag_phase_since_ms_.store(Clock::QueryHostUptimeMillis(),
+                             std::memory_order_relaxed);
+}
+
+void CommandProcessor::DiagStallReport() {
+  // Read from another thread while the GPU thread may be running: the values
+  // are approximate, which is enough to tell where it stands.
+  static const char* const kPhaseNames[] = {
+      "executing guest commands", "idle (ring empty)",
+      "strict occlusion: waiting for query results",
+      "waiting for background pipelines",
+      "waiting for the GPU to finish a submission", "guest WAIT_REG_MEM"};
+  const uint32_t phase = diag_phase_.load(std::memory_order_relaxed);
+  const uint64_t since = diag_phase_since_ms_.load(std::memory_order_relaxed);
+  XELOGW(
+      "STALL GPU thread: {} for {} ms; ring read {} write {}; submission "
+      "completed {}",
+      phase < uint32_t(DiagPhase::kCount) ? kPhaseNames[phase] : "?",
+      since ? Clock::QueryHostUptimeMillis() - since : 0, read_ptr_index_,
+      write_ptr_index_.load(), GetCompletedSubmission());
+  const char* mode = zpd_mode_ == ZPDMode::kStrict    ? "strict"
+                     : zpd_mode_ == ZPDMode::kFastAlt ? "fast-alt"
+                     : zpd_mode_ == ZPDMode::kFast    ? "fast"
+                                                      : "fake";
+  XELOGW(
+      "STALL occlusion {}{}: {} reports queued ({} awaited), front pending "
+      "{}; totals queued {} retired {} abandoned {} corrections {} pool "
+      "exhausted {} failed {}; idle resolves {}",
+      mode, zpd_force_fake_fallback_ ? " (fell back to fake)" : "",
+      zpd_reports_.size(), zpd_awaited_report_count_,
+      zpd_reports_.empty() ? 0u : zpd_reports_.front().pending_segments,
+      zpd_stats_.reports_queued, zpd_stats_.reports_retired,
+      zpd_stats_.retires_abandoned, zpd_stats_.speculative_corrections,
+      zpd_stats_.pool_exhausted, zpd_stats_.failed,
+      diag_strict_backstops_.load(std::memory_order_relaxed));
+  xe::FlushLog();
+}
