+// Textures read by the draws that render those targets (128 KiB each).
+inline std::atomic<uint32_t> frame_trace_ring_inputs[16];
+inline std::atomic<uint32_t> frame_trace_ring_input_count{0};
+inline bool FrameTraceRingInput(uint32_t start, uint32_t length) {
+  const uint32_t count = std::min<uint32_t>(
+      frame_trace_ring_input_count.load(std::memory_order_relaxed), 16);
+  for (uint32_t i = 0; i < count; ++i) {
+    const uint32_t base =
+        frame_trace_ring_inputs[i].load(std::memory_order_relaxed);
+    if (start < base + 0x20000 && base < start + length) {
+      return true;
+    }
+  }
+  return false;
+}
+inline void FrameTraceAddRingInput(uint32_t base) {
+  const uint32_t count = std::min<uint32_t>(
+      frame_trace_ring_input_count.load(std::memory_order_relaxed), 16);
+  for (uint32_t i = 0; i < count; ++i) {
+    if (frame_trace_ring_inputs[i].load(std::memory_order_relaxed) == base) {
+      return;
+    }
+  }
+  if (count < 16) {
+    frame_trace_ring_inputs[count].store(base, std::memory_order_relaxed);
+    frame_trace_ring_input_count.store(count + 1, std::memory_order_relaxed);
+  }
