+// SPDX-License-Identifier: GPL-3.0-or-later
+// The frame generation settings file (/app0/framegen.conf), shared by the launcher (which
+// writes it), the presenter (which reads it once, before the swapchain) and the host test.
+//
+//   ps5_frame_interpolation=true     line 1, exactly this or "=false": the switch of the builds
+//                                    before modes, which read nothing else
+//   ps5_frame_multiplier=auto        optional: auto, 2, 3 or 4. Missing or unknown: 2
+//   ps5_frame_output_hz=60           optional: auto, 60 or 120. Missing or unknown: 60
+//   ps5_frame_target=display         optional (PS5X360E): display, 30 or 40. 30: the generated
+//                                    pictures fill a slower game up to an even 30 FPS (each
+//                                    output held two 60 Hz refreshes) instead of the display's
+//                                    rate; the steady-rate path is not used then. 40: the
+//                                    same at 119.88 Hz, three refreshes an output (with a
+//                                    display that has no 120 Hz mode it falls back to 30).
+//   ps5_frame_pacing=auto            optional: auto or strict. Missing or unknown: auto.
+//                                    auto: in the Automatic mode, pictures are also generated
+//                                    when the game's frames are not of one length (adaptive
+//                                    pacing). strict: only the pacing of the builds before it.
+//
+// With lines 2 and 3 missing, the settings are the ones of the builds before modes: one
+// generated picture between two of the game's, on the 60 Hz output.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <string>
+
+namespace ps5x360::framegen {
+struct Config {
+  bool valid = false;        // line 1 is one of its two exact forms
+  bool enabled = false;      // line 1 is ps5_frame_interpolation=true
+  uint32_t multiplier = 2;   // 0: automatic; 2, 3 or 4
+  uint32_t output_hz = 60;   // 0: automatic; 60 or 120
+  bool has_multiplier = false, has_output = false;  // the line was there, with a known value
+  bool unknown_value = false;                       // a known key with a value that is not one of its own
+  std::string output_text;   // the output line's value as written: a writer that did not set it keeps it
+  bool adaptive_pacing = true;  // ps5_frame_pacing is not "strict"
+  bool has_pacing = false;      // the line was there, with a known value
+  std::string pacing_text;      // its value as written, kept by a writer the same way
+  uint32_t target_fps = 0;      // PS5X360E: 0 the display's rate, 30 an even 30 FPS
+  std::string target_text;      // its value as written ("": no such line)
+};
+
+constexpr const char* kSwitchOn = "ps5_frame_interpolation=true";
+constexpr const char* kSwitchOff = "ps5_frame_interpolation=false";
+constexpr const char* kMultiplierKey = "ps5_frame_multiplier=";
+constexpr const char* kOutputKey = "ps5_frame_output_hz=";
+constexpr const char* kPacingKey = "ps5_frame_pacing=";
+constexpr const char* kTargetKey = "ps5_frame_target=";
+
+inline const char* MultiplierText(uint32_t multiplier) {
+  return multiplier == 0 ? "auto" : multiplier == 3 ? "3" : multiplier == 4 ? "4" : "2";
+}
+inline const char* OutputText(uint32_t output_hz) {
+  return output_hz == 0 ? "auto" : output_hz == 120 ? "120" : "60";
+}
+// For the log: x2, x3, x4 or auto.
+inline const char* ModeText(uint32_t multiplier) {
+  return multiplier == 0 ? "auto" : multiplier == 3 ? "x3" : multiplier == 4 ? "x4" : "x2";
+}
+
+// The whole file's text. Line 1 is compared as the builds before modes compared it: up to the
+// first line break, carriage returns at its end dropped, nothing else forgiven.
+inline Config ParseConfig(const std::string& file) {
+  Config config;
+  const std::string text(file.c_str());  // as a C string: nothing after a NUL
+  size_t at = 0;
+  for (unsigned number = 0; at < text.size() && number < 16; ++number) {
+    const size_t end = std::min(text.find('\n', at), text.size());
+    std::string line = text.substr(at, end - at);
+    at = end + 1;
+    while (!line.empty() && line.back() == '\r') line.pop_back();
+    if (number == 0) {
+      config.valid = line == kSwitchOn || line == kSwitchOff;
+      config.enabled = line == kSwitchOn;
+      continue;
+    }
+    while (!line.empty() && (line.back() == ' ' || line.back() == '\t')) line.pop_back();
+    if (line.rfind(kMultiplierKey, 0) == 0) {
+      const std::string value = line.substr(std::strlen(kMultiplierKey));
+      const bool known = value == "auto" || value == "2" || value == "3" || value == "4";
+      if (known) {
+        config.multiplier = value == "auto" ? 0 : uint32_t(value[0] - '0');
+        config.has_multiplier = true;
+      } else {
+        config.unknown_value = true;
+      }
+    } else if (line.rfind(kOutputKey, 0) == 0) {
+      const std::string value = line.substr(std::strlen(kOutputKey));
+      config.output_text = value;
+      const bool known = value == "auto" || value == "60" || value == "120";
+      if (known) {
+        config.output_hz = value == "auto" ? 0 : value == "120" ? 120 : 60;
+        config.has_output = true;
+      } else {
+        config.unknown_value = true;
+      }
+    } else if (line.rfind(kTargetKey, 0) == 0) {
+      const std::string value = line.substr(std::strlen(kTargetKey));
+      config.target_text = value;
+      if (value == "display" || value == "30" || value == "40") {
+        config.target_fps = value == "30" ? 30 : value == "40" ? 40 : 0;
+      } else {
+        config.unknown_value = true;
+      }
+    } else if (line.rfind(kPacingKey, 0) == 0) {
+      const std::string value = line.substr(std::strlen(kPacingKey));
+      config.pacing_text = value;
+      if (value == "auto" || value == "strict") {
+        config.adaptive_pacing = value == "auto";
+        config.has_pacing = true;
+      } else {
+        config.unknown_value = true;
+      }
+    }
+  }
+  return config;
+}
+
+// What the launcher writes: always the three lines, line 1 first for the builds before modes.
+// `output_text` is written as it is when not empty (a value the launcher did not set). The
+// pacing line is written only when the file had one (`pacing_text` not empty), as it was.
+inline std::string FormatConfig(bool enabled, uint32_t multiplier, const std::string& output_text,
+                                const std::string& pacing_text = std::string(),
+                                const std::string& target_text = std::string()) {
+  std::string text = enabled ? kSwitchOn : kSwitchOff;
+  text += "\n";
+  text += kMultiplierKey;
+  text += MultiplierText(multiplier);
+  text += "\n";
+  text += kOutputKey;
+  text += output_text.empty() ? "60" : output_text;
+  text += "\n";
+  if (!target_text.empty()) {
+    text += kTargetKey;
+    text += target_text;
+    text += "\n";
+  }
+  if (!pacing_text.empty()) {
+    text += kPacingKey;
+    text += pacing_text;
+    text += "\n";
+  }
+  return text;
+}
+
+// The refresh asked of the display, in millihertz: the surface's own request (60000) unless the
+// file asks for more. Automatic and 120 ask for 120000; the mode nearest to it that the driver
+// lists is taken, so a console or a display without 120 Hz stays at 59.94 Hz by itself.
+inline uint32_t RequestedRefreshMillihertz(const Config& config, uint32_t surface_request) {
+  if (config.enabled && config.target_fps == 40) return 120000u;  // PS5X360E: 40 needs 120 Hz
+  return config.output_hz == 60 ? surface_request : 120000u;
+}
+
+// Whether adaptive pacing may be used at all: frame generation on, the Automatic mode, and the
+// pacing line not "strict". The fixed 2x, 3x and 4x modes are paced strictly, as before.
+// The most pictures the adaptive path makes between two frames of the game: the mode's limit
+// (2x: one, 3x: two, 4x and Automatic: three).
+inline uint32_t AdaptiveCap(const Config& config) {
+  return config.multiplier == 2 ? 1u : config.multiplier == 3 ? 2u : 3u;
+}
+// Every mode: the path takes over whenever strict pacing is not engaged, unless the file says
+// ps5_frame_pacing=strict.
+inline bool AdaptivePacingEnabled(const Config& config) {
+  return config.valid && config.enabled && (config.adaptive_pacing || config.target_fps);
+}
+}  // namespace ps5x360::framegen
diff --git a/src/xenia/ui/vulkan/framegen/pacing_adapter.hpp b/src/xenia/ui/vulkan/framegen/pacing_adapter.hpp
new file mode 100644
index 000000000..b78936006
--- /dev/null
+++ b/src/xenia/ui/vulkan/framegen/pacing_adapter.hpp
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <limits>
+#include "source_clock.hpp"
+#include "vendor/ps5_framegen_pacing.h"
+namespace ps5x360::framegen {
+class Pacing {
+  static constexpr uint32_t kModeIntervals = 2 * ps5::framegen::pacer::kWindow;
+  ps5::framegen::pacer pacer_;
+  Stamp previous_{};
+  std::array<uint32_t, 8> intervals_{};
+  std::array<double, 8> elapsed_{};
+  uint32_t next_ = 0, count_ = 0, cadence_ = 0, native_ticks_ = 0;
+  uint32_t dormant_ticks_ = 0, dormant_count_ = 0;
+  int phase_ = 0;
+  double reference_ns_per_tick_ = 0, rate_ = 100, display_ = 0;
+  double source_rate_ = 0;
+  const void* owner_ = nullptr;
+  uint32_t width_ = 0, height_ = 0, already_ = 0, presents_ = 0;
+  // Modes: the multiplier asked for (0: automatic; 2, 3, 4) and this frame's plan. With 2, the
+  // plan is the one of the builds before modes: one picture held presents_ refreshes.
+  uint32_t multiplier_ = 2, generated_ = 0, hold_ = 0, fit_ = 0, cadence_breaks_ = 0;
+  bool engaged_ = false;
+  std::chrono::steady_clock::time_point last_progress_{};
+
+  void ClearCadence() {
+    intervals_ = {}; elapsed_ = {}; next_ = count_ = cadence_ = 0;
+    phase_ = 0; engaged_ = false; presents_ = already_ = 0;
+    generated_ = hold_ = fit_ = 0;
+    dormant_ticks_ = dormant_count_ = 0;
+    last_progress_ = {};
+    // Keep the producer reference, native cadence ceiling and upstream backoff.
+    // A load/wait must not train a slower reference or forgive a costly pause.
+  }
+  // The upstream pacer takes a source clock of 20 to 100 Hz and uses the two rates only as
+  // their ratio. A 120 Hz guest clock (the launcher's video clock option) is given to it with
+  // both rates halved: the same ratio, inside its range. 1 for the usual 60 Hz clock.
+  static double PacerScale(double source_hz) { return source_hz > 100 ? 0.5 : 1.0; }
+  void Gap(const Stamp& s) {
+    ClearCadence();
+    pacer_.frame(ps5::framegen::pacer::kGapTicks + 1, 0, s.hz * PacerScale(s.hz),
+                 display_ * PacerScale(s.hz), double(s.ns) * 1e-9, rate_, false);
+    previous_ = s;
+  }
+  void Plan(uint32_t fit, uint32_t left) {
+    const Pictures plan = PlanPictures(multiplier_, presents_, fit, left);
+    fit_ = fit;
+    generated_ = plan.generated;
+    hold_ = plan.hold;
+  }
+ public:
+  // The pictures generated for a frame and the refreshes each is shown before the next
+  // picture. `multiplier`: 0 automatic, or 2, 3, 4. `presents`: the refreshes the upstream
+  // pacer gives one generated picture (0: none this frame). `fit`: the refreshes the frame's
+  // interval is worth. `left`: those not spent by presents already made in it.
+  struct Pictures { uint32_t generated, hold; };
+  static Pictures PlanPictures(uint32_t multiplier, uint32_t presents, uint32_t fit,
+                               uint32_t left) {
+    // One picture held as the pacer says: all there is with 2, and the fallback of the others.
+    const Pictures one{presents ? 1u : 0u, presents};
+    if (!presents || multiplier == 2) return one;
+    // Automatic: the most pictures (up to 3) that divide the interval into equal parts, so the
+    // game's own frame and the generated ones are all shown for the same time.
+    const uint32_t times = multiplier ? multiplier : fit % 4 == 0 ? 4 : fit % 3 == 0 ? 3 : 2;
+    // The multiplier is a most: never more pictures than the interval has refreshes to spare.
+    const uint32_t pictures = std::min(times - 1, left);
+    if (pictures < 2) return one;
+    uint32_t hold = fit % times == 0 ? fit / times : 1;
+    if (pictures * hold > left) hold = 1;
+    return {pictures, hold};
+  }
+  bool Observe(uint64_t, uint64_t serial, uint32_t w, uint32_t h, double display,
+               bool permit, bool enabled, const void* owner) {
+    Stamp s;
+    presents_ = 0;
+    generated_ = hold_ = 0;
+    if (!permit || !enabled || !w || !h || !std::isfinite(display) ||
+        display < 30 || display > 250) {
+      Reset(); return false;
+    }
+    // Missing telemetry is a suspension, not proof that generation became cheap.
+    // Discard the timing anchor so the next stamp cannot bridge unknown frames.
+    if (!Lookup(owner, serial, s) || !std::isfinite(s.hz) ||
+        s.hz < 20 || s.hz > 200 || !s.ns || display * PacerScale(s.hz) < 20) {
+      Suspend(); return false;
+    }
+    if (w != width_ || h != height_ || display != display_ ||
+        s.hz != source_rate_ || s.owner != owner_) {
+      Reset(); width_ = w; height_ = h; display_ = display;
+      source_rate_ = s.hz; owner_ = s.owner;
+    }
+    if (!previous_.ns) { previous_ = s; return false; }
+    // Reobserving the same tick/time (even another serial) neither warms nor
+    // spends ticks. Clock equality alone is not a clock rollback.
+    if (s.ns == previous_.ns && s.ticks == previous_.ticks) return false;
+    if (s.ns <= previous_.ns || s.ticks < previous_.ticks) {
+      Gap(s); return false;
+    }
+    const uint64_t ticks = s.ticks - previous_.ticks;
+    const double dt = double(s.ns - previous_.ns);
+    if (ticks > ps5::framegen::pacer::kGapTicks ||
+        dt > 1e9 * ps5::framegen::pacer::kGapTicks / s.hz) {
+      Gap(s); return false;
+    }
+    // A new mailbox submission can land within the same source tick. Do not
+    // insert a fictitious tick, move the timing anchor, or discard presents.
+    if (!ticks) return false;
+    previous_ = s;
+    last_progress_ = std::chrono::steady_clock::now();
+    intervals_[next_] = uint32_t(ticks); elapsed_[next_] = dt;
+    next_ = (next_ + 1) % intervals_.size();
+    count_ = std::min<uint32_t>(count_ + 1, intervals_.size());
+    uint32_t usual = 0, same = 0;
+    double total_ticks = 0, total_ns = 0;
+    for (uint32_t i = 0; i < count_; ++i) {
+      total_ticks += intervals_[i]; total_ns += elapsed_[i];
+      uint32_t n = 0;
+      for (uint32_t j = 0; j < count_; ++j) n += intervals_[j] == intervals_[i];
+      if (n > same) { same = n; usual = intervals_[i]; }
+    }
+    // This is relative producer throughput, NOT CPU/emulation speed telemetry.
+    // Aggregate ns/tick removes short/long scheduling pairs. Freeze the first
+    // full-window reference (capped at the declared source tick rate) even
+    // while waiting or in the safety pause; otherwise
+    // generated-frame cost could gradually become the new "100 percent".
+    if (count_ == intervals_.size() && !reference_ns_per_tick_)
+      reference_ns_per_tick_ = std::min(total_ns / total_ticks, 1e9 / s.hz);
+    rate_ = reference_ns_per_tick_ ?
+        std::min(100.0, 100.0 * reference_ns_per_tick_ * total_ticks / total_ns) : 100;
+
+    // A slower *game-frame* mode needs two windows (16) of real intervals while
+    // generation is dormant and the producer clock meets the frozen reference.
+    // Active generation, safety pauses, zero ticks, gaps and missing stamps
+    // cannot train this transition. A generated-frame wait must first disappear
+    // for two complete new windows, rather than promoting its own slower cadence.
+    if (!engaged_ && !pacer_.paused() && native_ticks_ &&
+        ticks > native_ticks_ && rate_ >= ps5::framegen::pacer::kFullSpeed) {
+      if (dormant_ticks_ != ticks) { dormant_ticks_ = uint32_t(ticks); dormant_count_ = 0; }
+      dormant_count_ = std::min(dormant_count_ + 1, kModeIntervals);
+    } else dormant_ticks_ = dormant_count_ = 0;
+
+    bool nominal = true;
+    if (cadence_) {
+      uint32_t exact = 0;
+      for (uint32_t i = 0; i < count_; ++i) exact += intervals_[i] == cadence_;
+      const int error = int(ticks) - int(cadence_);
+      phase_ += error;
+      // Only sustain sparse, compensated one-tick jitter around an acquired
+      // cadence. Four exact intervals and bounded phase reject dense 1/3,
+      // alternating 1/2, drifting 2/3 and larger excursions.
+      if (std::abs(error) > 1 || std::abs(phase_) > 1 || exact < 4) {
+        cadence_ = 0; phase_ = 0; nominal = false;
+        if (engaged_ && cadence_breaks_ != std::numeric_limits<uint32_t>::max()) ++cadence_breaks_;
+      }
+    } else if (count_ == intervals_.size() && same >= 7) {
+      // Normal acquisition stays strict (7/8). Promotion to a slower mode
+      // requires a full unmixed window and the dormant evidence above.
+      if (!native_ticks_) native_ticks_ = usual;
+      if (usual > native_ticks_ && same == intervals_.size() &&
+          dormant_ticks_ == usual && dormant_count_ == kModeIntervals)
+        native_ticks_ = usual;
+      if (usual <= native_ticks_) { cadence_ = usual; phase_ = 0; }
+      else nominal = false;
+    } else nominal = false;
+
+    // The upstream pacer handles warmup, refresh hysteresis and the unchanged
+    // 3s / 10..160s safety backoff. Its cadence input is a classification only;
+    // source stamps/ticks are never rewritten. ALL spending uses the current
+    // raw interval, including short jitter intervals, with no borrowed credit.
+    const uint32_t admission_ticks = cadence_ ? cadence_ : uint32_t(ticks);
+    const uint32_t fit = uint32_t(ticks * display / s.hz + 0.03);
+    const uint32_t left = fit > already_ ? fit - already_ : 0;
+    const uint32_t admission_fit = uint32_t(admission_ticks * display / s.hz + 0.03);
+    const auto d = pacer_.frame(admission_ticks,
+        left ? already_ : std::max(already_, admission_fit), s.hz * PacerScale(s.hz),
+        display * PacerScale(s.hz), double(s.ns) * 1e-9, rate_, nominal);
+    already_ = 0;
+    engaged_ = d.engaged;
+    presents_ = engaged_ ? std::min(d.presents, left) : 0;
+    Plan(fit, left);
+    return engaged_ && presents_ != 0;
+  }
+  // 0: automatic; 2, 3 or 4 (anything else: 2). Kept across Reset(): it is a setting.
+  void SetMultiplier(uint32_t multiplier) {
+    multiplier_ = multiplier == 0 || multiplier == 3 || multiplier == 4 ? multiplier : 2;
+  }
+  uint32_t Multiplier() const { return multiplier_; }
+  // This frame's plan, valid after an Observe() that returned true: the generated pictures
+  // (1 to 3), the refreshes each is shown, and the refreshes the frame's interval is worth.
+  uint32_t Generated() const { return generated_; }
+  uint32_t HoldRefreshes() const { return hold_; }
+  uint32_t IntervalRefreshes() const { return fit_; }
+  // Times an acquired cadence was lost while generating, since the start (a diagnostic).
+  uint32_t CadenceBreaks() const { return cadence_breaks_; }
+  void Presented(bool success) {
+    if (success && already_ != std::numeric_limits<uint32_t>::max()) ++already_;
+  }
+  bool Engaged() {
+    const uint64_t tick = source_ticks.load(std::memory_order_relaxed);
+    // Wall time is a liveness timeout only, never admission or refresh credit.
+    // It also releases UI paints if BOTH producer frames and source ticks stop.
+    const bool stale = engaged_ &&
+        std::chrono::duration<double>(std::chrono::steady_clock::now() -
+                                      last_progress_).count() >
+            ps5::framegen::pacer::kGapTicks / previous_.hz;
+    if (engaged_ && (stale || tick < previous_.ticks ||
+        tick - previous_.ticks > ps5::framegen::pacer::kGapTicks)) {
+      // Invalidate history without erasing an ongoing safety pause.
+      Stamp s = previous_; s.ticks = tick;
+      Gap(s);
+    }
+    return engaged_;
+  }
+  // How long one generated picture is shown before the next picture is queued.
+  double HoldNanoseconds() const { return display_ > 0 ? 1e9 * hold_ / display_ : 0; }
+  // Optional diagnostics: relative producer throughput and upstream safety
+  // state, never a claim of measured CPU speed. Existing methods are unchanged.
+  double ProducerRatePercent() const { return rate_; }
+  bool ProducerReferenceReady() const { return reference_ns_per_tick_ > 0; }
+  bool SafetyPaused() const { return pacer_.paused(); }
+  // Where strict pacing is, in words for the log (the upstream pacer's state).
+  const char* StrictStateText() const {
+    switch (pacer_.state()) {
+      case ps5::framegen::pacer_state::Warming: return "warming up";
+      case ps5::framegen::pacer_state::NoRoom: return "no room, under two refreshes a frame";
+      case ps5::framegen::pacer_state::Unsteady: return "frames of uneven length";
+      case ps5::framegen::pacer_state::NotNominal: return "cadence lost";
+      case ps5::framegen::pacer_state::Paused: return "safety pause";
+      case ps5::framegen::pacer_state::Generating: return "generating";
+    }
+    return "unknown";
+  }
+  double NextSafetyPauseSeconds() const { return pacer_.next_pause(); }
+  double SafetyProducerRatePercent() const { return pacer_.slow_speed(); }
+  double SafetyRecoveryRatePercent() const { return pacer_.no_fg_speed(); }
+  // For an inactive mailbox / lost telemetry: invalidate admission and history
+  // anchors while preserving producer reference and all upstream safety state.
+  // Configuration is separate from previous_, so resuming the same owner/extent
+  // does not accidentally Reset() when its first new stamp seeds the anchor.
+  void Suspend() {
+    if (previous_.ns)
+      pacer_.frame(ps5::framegen::pacer::kGapTicks + 1, 0, source_rate_ * PacerScale(source_rate_),
+                   display_ * PacerScale(source_rate_), double(previous_.ns) * 1e-9, rate_, false);
+    ClearCadence(); previous_ = {};
+  }
+  void InvalidateCadence() { Suspend(); }
+  void Reset() {
+    pacer_ = {}; previous_ = {}; ClearCadence(); native_ticks_ = 0;
+    reference_ns_per_tick_ = display_ = 0; rate_ = 100; width_ = height_ = 0;
+    source_rate_ = 0; owner_ = nullptr;
+  }
+};
+}
diff --git a/src/xenia/ui/vulkan/framegen/presenter_sidecar.hpp b/src/xenia/ui/vulkan/framegen/presenter_sidecar.hpp
new file mode 100644
index 000000000..45de8c918
--- /dev/null
+++ b/src/xenia/ui/vulkan/framegen/presenter_sidecar.hpp
@@ -0,0 +1,460 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Included in exactly one presenter translation unit. No frozen class members.
+#pragma once
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include "adaptive_pacing.hpp"
+#include "framegen_config.hpp"
+#include "pacing_adapter.hpp"
+#include "vendor/ps5_framegen.h"
+#include "vendor/sword_loader.hpp"
+
+namespace xe::ui::vulkan {
+namespace {
+bool FramegenDrawUI(bool requested, bool) { return requested; }
+void ReleaseInactiveFramegenConsumer(std::unique_lock<std::mutex>& lock, bool active) {
+  if (!active && lock.owns_lock()) lock.unlock();
+}
+// The settings file as read at the start: the switch, the multiplier and the output rate.
+ps5x360::framegen::Config& FramegenConfig() {
+  static ps5x360::framegen::Config config;
+  return config;
+}
+// The refresh to ask of the display, in millihertz, given the surface's own request.
+uint32_t FramegenRequestedRefresh(uint32_t surface_request) {
+  return ps5x360::framegen::RequestedRefreshMillihertz(FramegenConfig(), surface_request);
+}
+void FramegenNoteDisplay(uint32_t requested, uint32_t surface_request, uint32_t selected) {
+  static bool logged = false;
+  if (logged || requested == surface_request) return;
+  logged = true;
+  // Accepted: selected_hz is 119.88. Otherwise the driver listed no such mode.
+  XELOGW("Framegen output: asked for {} Hz, selected_hz={}{}", requested / 1000,
+         double(selected) / 1000.0,
+         selected >= 100000 ? " (120 Hz output accepted)"
+                            : " (no 120 Hz mode offered: the title's param.json attribute3, the "
+                              "console's 120 Hz setting or the display; staying at 60 Hz)");
+}
+void LoadFramegenPrivateConfig() {
+  // No launcher Settings field. Read once per process, before swapchain setup.
+  static bool loaded = false;
+  if (loaded) return;
+  loaded = true;
+  const char* path = "/app0/framegen.conf";
+  std::FILE* file = std::fopen(path, "rb");
+  if (!file) {
+    path = "/data/homebrew/PPSA50011/framegen.conf";
+    file = std::fopen(path, "rb");
+  }
+  if (!file) {
+    XELOGW("Framegen config unavailable in /app0 or installation root; disabled");
+    return;
+  }
+  char text[1024]{};
+  const size_t length = std::fread(text, 1, sizeof(text) - 1, file);
+  std::fclose(file);
+  auto& config = FramegenConfig();
+  config = ps5x360::framegen::ParseConfig(std::string(text, length));
+  const bool valid = config.valid;
+  // Line 1 decides alone whether the file counts, as before modes; a file it rejects gives
+  // nothing else either.
+  if (!valid) config = {};
+  cvars::ps5_frame_interpolation = valid && config.enabled;
+  XELOGW("Framegen private config: {} enabled={} valid={} (restart required)",
+         path, bool(cvars::ps5_frame_interpolation), valid);
+  if (config.target_fps)
+    XELOGW("Framegen private config: target {} FPS (adaptive pacing only{})", config.target_fps,
+           config.target_fps == 40 ? "; 120 Hz output asked, 30 FPS if the display has none" : "");
+  if (config.has_multiplier || config.has_output || config.has_pacing || config.unknown_value)
+    XELOGW("Framegen private config: multiplier={}{} output_hz={}{} pacing={}{}{}",
+           ps5x360::framegen::MultiplierText(config.multiplier),
+           config.has_multiplier ? "" : " (default)",
+           ps5x360::framegen::OutputText(config.output_hz), config.has_output ? "" : " (default)",
+           config.adaptive_pacing ? "auto" : "strict", config.has_pacing ? "" : " (default)",
+           config.unknown_value ? "; a line with an unknown value was ignored" : "");
+}
+struct FramegenSidecar {
+  struct Image { VkImage image{}; VkImageView view{}; VkDeviceMemory memory{}; };
+  VulkanDevice* device = nullptr;
+  Image images[3]{};  // Two private snapshots and one private midpoint.
+  ps5::framegen::interpolator interpolation;
+  ps5x360::framegen::Pacing pacing;
+  VkDescriptorPool pool{};
+  VkDescriptorSet sampled[3]{};
+  PFN_vkCmdCopyImage copy_image = nullptr;
+  VkExtent2D extent{};
+  uint32_t current = 0;
+  bool interpolation_history = false;
+  bool history = false, initialized = false, failed = false;
+  uint64_t serial = 0;
+  std::shared_ptr<void> source_keepalive;
+  uint64_t source_copy_submission = 0;
+  // Independently of effect_count, every snapshot has an owning GPU lease.
+  bool RetireSource(uint64_t completed_submission) {
+    if (source_keepalive && source_copy_submission > completed_submission) return false;
+    source_keepalive.reset(); source_copy_submission = 0; return true;
+  }
+  bool RetainSnapshotSource(std::shared_ptr<void> source, uint64_t submission) {
+    if (source_keepalive || !source) return false;
+    source_keepalive = std::move(source); source_copy_submission = submission;
+    return true;
+  }
+  double display_hz = 0;
+  uint64_t paints = 0, new_frames = 0, admitted = 0;
+  uint64_t dormant_frames = 0, snapshot_waits = 0, snapshot_wait_ns = 0;
+  uint64_t snapshot_wait_max_ns = 0;
+  uint64_t deferred_frames = 0;
+  // Modes: the generated pictures of the frame recorded last (0: none; 1 to 3), and what the
+  // log last said about the multiplier in effect.
+  uint32_t pictures = 0, plan_logged = 0, plan_logs = 0;
+  // Diagnostics of the presentation queue, reported with the presentation cost: source frames
+  // never painted while generating, generated presents that waited for a free swapchain image
+  // (a full queue), and cadence losses.
+  uint64_t skipped_sources = 0, slow_acquires = 0;
+  uint32_t cadence_breaks_reported = 0;
+  bool acquire_pending = false;
+  // Adaptive pacing (adaptive_pacing.hpp): pictures for a game whose frames are not of one
+  // length, used only while strict pacing is not engaged, in the Automatic mode.
+  ps5x360::framegen::AdaptivePacing adaptive;
+  ps5x360::framegen::AdaptivePlan plan;  // of the frame being presented
+  bool adaptive_backlog = false;         // this span's first acquire found the queue full
+  bool adaptive_announced = false;
+  uint32_t adaptive_run = 0, adaptive_logs = 0;
+  double adaptive_fps = 0;
+  // The 600-frame summary: frames paced by each path, and the presents made for them.
+  uint64_t strict_frames = 0, adaptive_frames = 0, outputs_reported = 0, backlogs_reported = 0;
+  static constexpr uint32_t kAdaptiveAnnounce = 8;  // game frames in a row before "started" is logged
+  static constexpr uint32_t kAdaptiveLogs = 48;     // start and stop lines per process
+  static bool AdaptiveEnabled() { return ps5x360::framegen::AdaptivePacingEnabled(FramegenConfig()); }
+  static uint64_t NowNanoseconds() {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+  }
+  // The path stops pacing: said once in the log if its start was.
+  void AdaptiveEnd(const char* why) {
+    if (adaptive_announced && adaptive_logs < kAdaptiveLogs) {
+      XELOGW("Framegen adaptive: stopped after {} game frames ({}; game at {:.1f} FPS){}",
+             adaptive_run, why, adaptive_fps,
+             ++adaptive_logs == kAdaptiveLogs ? "; further starts and stops are not logged" : "");
+    }
+    adaptive_announced = false;
+    adaptive_run = 0;
+  }
+  void AdaptiveStop(const char* why) {
+    if (adaptive.active() || adaptive_run) AdaptiveEnd(why);
+    adaptive.Stop();
+  }
+  // A new frame of the game, after strict pacing has looked at it. True when this span is
+  // paced by the adaptive path: `plan` then holds its outputs.
+  bool AdaptiveArrive(const void* owner, uint64_t next_serial, uint64_t now_ns, bool strict) {
+    plan = {};
+    adaptive_backlog = false;
+    if (!AdaptiveEnabled()) return false;
+    ps5x360::framegen::Stamp stamp;
+    if (!ps5x360::framegen::Lookup(owner, next_serial, stamp) || !stamp.ns) {
+      AdaptiveStop("no time stamp for the game's frame");
+      adaptive.Reset();
+      return false;
+    }
+    const uint64_t step = serial && next_serial > serial ? next_serial - serial : 0;
+    plan = adaptive.Arrive(stamp.ns, now_ns, step, display_hz, !strict && !pacing.SafetyPaused(),
+                           history && interpolation_history,
+                           ps5x360::framegen::AdaptiveCap(FramegenConfig()),
+                           FramegenConfig().target_fps);
+    if (!plan.active) {
+      using Reason = ps5x360::framegen::AdaptiveReason;
+      if (adaptive_run) {
+        AdaptiveEnd(plan.reason == Reason::NotAllowed ? (strict ? "strict pacing engaged" : "safety pause")
+                    : plan.reason == Reason::Gap ? "a gap in the game's frames"
+                    : plan.reason == Reason::TooSlow ? "game below 10 FPS"
+                    : plan.reason == Reason::TooFast ? "game at the display's rate"
+                    : "the game's rate is being measured");
+      }
+      return false;
+    }
+    ++adaptive_frames;
+    adaptive_fps = adaptive.fps();
+    if (++adaptive_run == kAdaptiveAnnounce && adaptive_logs < kAdaptiveLogs) {
+      ++adaptive_logs;
+      adaptive_announced = true;
+      XELOGW("Framegen adaptive: started (game at {:.1f} FPS on selected_hz={}; strict pacing: {})",
+             adaptive_fps, display_hz, pacing.StrictStateText());
+    }
+    return true;
+  }
+  // The plan cannot be carried out from output `from` on (no picture was made, or the queue is
+  // full): the game's frame takes that place and ends the span.
+  void AdaptiveCut(uint32_t from) {
+    plan.outputs[from] = {int8_t(-1), 1};
+    plan.count = from + 1;
+    adaptive.ShownAlone(NowNanoseconds());
+  }
+  // Between two frames of the game nothing else is presented while the path paces.
+  bool AdaptiveHolding() {
+    if (!adaptive.active()) return false;
+    if (adaptive.Holding(NowNanoseconds())) return true;
+    AdaptiveEnd("no new frame from the game");
+    return false;
+  }
+  // A new source serial: the ones between it and the last painted were never shown.
+  void NoteSerial(uint64_t next) {
+    if (history && pictures && serial && next > serial + 1) skipped_sources += next - serial - 1;
+  }
+  // The wait of the first acquire of a frame's generated pictures. Over 2 ms, no image was
+  // free before a refresh: every image was queued or on screen.
+  void NoteAcquire(std::chrono::steady_clock::duration wait) {
+    if (!acquire_pending) return;
+    acquire_pending = false;
+    if (wait > std::chrono::milliseconds(2)) {
+      ++slow_acquires;
+      adaptive_backlog = true;
+    }
+  }
+  // The multiplier in effect, logged when it changes (a few times, not per frame). Nothing is
+  // logged for the plain 2x of the builds before modes.
+  void NotePlan() {
+    const uint32_t times = pacing.Generated() + 1;
+    if (pacing.Multiplier() == 2 || times == plan_logged || !pacing.Generated()) return;
+    if (plan_logs < 24) {
+      XELOGW("Framegen {}: {}x in effect ({} generated, each shown {} refresh(es); a game frame "
+             "lasts {} refreshes at selected_hz={}){}",
+             pacing.Multiplier() ? "multiplier" : "automatic", times, pacing.Generated(),
+             pacing.HoldRefreshes(), pacing.IntervalRefreshes(), display_hz,
+             ++plan_logs == 24 ? "; further changes are not logged" : "");
+    }
+    plan_logged = times;
+  }
+  void ReportPresentationCost() {
+    if (new_frames % 600 != 0) return;
+    const uint32_t breaks = pacing.CadenceBreaks();
+    const uint64_t backlogs = adaptive.backlogs();
+    if (skipped_sources || slow_acquires || breaks != cadence_breaks_reported || backlogs != backlogs_reported)
+      XELOGW("Framegen queue: skipped_source={} slow_acquire={} cadence_breaks={} adaptive_backlog={} "
+             "in the last 600 source frames", skipped_sources, slow_acquires,
+             breaks - cadence_breaks_reported, backlogs - backlogs_reported);
+    cadence_breaks_reported = breaks;
+    backlogs_reported = backlogs;
+    skipped_sources = slow_acquires = 0;
+    // strict and adaptive: frames paced by each path; dormant: frames shown without generation.
+    const uint64_t outputs = midpoint_present_ok + ordinary_present_ok;
+    XELOGW("Framegen presentation cost: source={} dormant={} deferred={} waits={} mean={}ms max={}ms "
+           "strict={} adaptive={} outputs_per_source={:.2f}",
+           new_frames, dormant_frames, deferred_frames, snapshot_waits,
+           snapshot_waits ? double(snapshot_wait_ns) / double(snapshot_waits) / 1e6 : 0.0,
+           double(snapshot_wait_max_ns) / 1e6, strict_frames, adaptive_frames,
+           double(outputs - outputs_reported) / 600.0);
+    outputs_reported = outputs;
+    strict_frames = adaptive_frames = 0;
+    dormant_frames = deferred_frames = snapshot_waits = snapshot_wait_ns = snapshot_wait_max_ns = 0;
+  }
+  uint64_t midpoint_present_ok = 0, ordinary_present_ok = 0;
+  uint64_t fallback_paints = 0, ui_skips = 0, failures = 0;
+  uint32_t fallback_log_mask = 0;
+  bool enabled_logged = false, admission_logged = false;
+  void LogEnabled() {
+    if (enabled_logged) return;
+    enabled_logged = true;
+    XELOGW("Framegen enabled (Sword FSR3 optical flow): selected_hz={}, FIFO required", display_hz);
+    const auto& config = FramegenConfig();
+    const char* const in_effect = config.multiplier == 0 ? "2x to 4x by the game's cadence"
+        : config.multiplier == 3 ? "up to 3x" : config.multiplier == 4 ? "up to 4x" : "2x";
+    XELOGW("Framegen mode: {}, multiplier {}, output asked {} Hz, selected_hz={}, pacing {}",
+           config.multiplier == 0 ? "automatic" : config.multiplier == 3 ? "3x"
+               : config.multiplier == 4 ? "4x" : "2x",
+           in_effect, FramegenRequestedRefresh(60000) / 1000, display_hz,
+           AdaptiveEnabled() ? "strict, adaptive when the game's frames are uneven" : "strict only");
+  }
+  void Fallback(uint32_t reason, const char* text) {
+    ++fallback_paints;
+    if (!(fallback_log_mask & reason)) {
+      fallback_log_mask |= reason;
+      XELOGW("Framegen fallback: {}", text);
+    }
+  }
+  // Called only after ALL referencing paint submissions have completed.
+  void DestroyImages(bool reset_pacing = true) {
+    // Entry points that release GPU resources MUST first retire paint work.
+    source_keepalive.reset(); source_copy_submission = 0;
+    if (reset_pacing) pacing.Reset();
+    if (reset_pacing) AdaptiveStop("the display was set up again");
+    if (reset_pacing) adaptive.Reset();
+    if (!device) return;
+    const auto& f = device->functions(); auto d = device->device();
+    interpolation.destroy();
+    if (pool) f.vkDestroyDescriptorPool(d, pool, nullptr);
+    pool = {}; for (auto& set : sampled) set = {};
+    for (auto& i : images) i = {}; // Owned by the interpolator.
+    interpolation_history = initialized = history = false; serial = 0; current = 0;
+    pictures = 0; acquire_pending = false;
+    extent = {};
+  }
+  ~FramegenSidecar() {
+    if (paints || enabled_logged) {
+      XELOGW("Framegen summary: paints={} new_frames={} admitted={} "
+             "midpoint_present_ok={} ordinary_present_ok={} "
+             "fallback_paints={} ui_skips={} failures={} (present acceptance, not scanout FPS)",
+             paints,new_frames,admitted,midpoint_present_ok,ordinary_present_ok,
+             fallback_paints,ui_skips,failures);
+    }
+    DestroyImages();
+  }
+  bool Prepare(VulkanDevice* dev, VkExtent2D size, VkFormat source_format,
+               VkDescriptorSetLayout sampled_layout) {
+    if (failed) return false;
+    if (initialized && size.width == extent.width && size.height == extent.height) return true;
+    // Observe already qualified the new extent. Recreate visual history without
+    // discarding that producer cadence. Failure/teardown still resets pacing.
+    DestroyImages(false); device = dev; extent = size;
+    auto fail = [&] { DestroyImages(); failed = true; return false; };
+    // Copy requires identical source/snapshot formats; no reinterpretation.
+    if (source_format != VK_FORMAT_A2B10G10R10_UNORM_PACK32) return fail();
+    VkFormatProperties properties{};
+    dev->vulkan_instance()->functions().vkGetPhysicalDeviceFormatProperties(
+        dev->physical_device(), source_format, &properties);
+    const auto required = VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT |
+        VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT |
+        VK_FORMAT_FEATURE_TRANSFER_SRC_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+    if ((properties.optimalTilingFeatures & required) != required) return fail();
+    dev->vulkan_instance()->functions().vkGetPhysicalDeviceFormatProperties(
+        dev->physical_device(), ps5::framegen::interpolator::k_format, &properties);
+    const auto output_required = VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT |
+        VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT |
+        VK_FORMAT_FEATURE_TRANSFER_SRC_BIT;
+    if ((properties.optimalTilingFeatures & output_required) != output_required) return fail();
+    auto d = dev->device(); const auto& f = dev->functions();
+    const auto& ifn = dev->vulkan_instance()->functions();
+    auto instance = dev->vulkan_instance()->instance();
+    auto loader = reinterpret_cast<PFN_vkGetDeviceProcAddr>(ifn.vkGetInstanceProcAddr(instance,"vkGetDeviceProcAddr"));
+    if (!loader || !ps5x360::sword_dispatch::Bind(instance,d,ifn.vkGetInstanceProcAddr)) return fail();
+    copy_image = reinterpret_cast<PFN_vkCmdCopyImage>(loader(d,"vkCmdCopyImage"));
+    if (!copy_image) return fail();
+    std::string error;
+    if (!interpolation.create(dev->physical_device(),d,size.width,size.height,error,source_format)) {
+      XELOGE("Framegen: Sword interpolator setup failed: {}",error);
+      return fail();
+    }
+    for (unsigned i=0;i<2;++i) { images[i].image=interpolation.snapshot_image(i); images[i].view=interpolation.snapshot_view(i); }
+    images[2].image=interpolation.output_image(); images[2].view=interpolation.output_view();
+    XELOGW("Framegen: Sword FSR3 ready for {}x{} (6436210, {})",size.width,size.height,
+           ps5x360::framegen::ModeText(pacing.Multiplier()));
+    VkDescriptorPoolSize counts[] = {{VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 3},
+                                    {VK_DESCRIPTOR_TYPE_SAMPLER, 3}};
+    VkDescriptorPoolCreateInfo p{}; p.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+    p.maxSets = 3; p.poolSizeCount = 2; p.pPoolSizes = counts;
+    if (f.vkCreateDescriptorPool(d, &p, nullptr, &pool) != VK_SUCCESS) return fail();
+    VkDescriptorSetAllocateInfo a{}; a.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+    VkDescriptorSetLayout layouts[] = {sampled_layout,sampled_layout,sampled_layout};
+    a.descriptorPool = pool; a.descriptorSetCount = 3; a.pSetLayouts = layouts;
+    if (f.vkAllocateDescriptorSets(d, &a, sampled) != VK_SUCCESS) return fail();
+    VkDescriptorImageInfo info[3]{}; VkWriteDescriptorSet writes[3]{};
+    for (uint32_t n=0;n<3;++n) {
+      info[n].imageView = images[n].view; info[n].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+      auto& w=writes[n];w.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+      w.dstSet = sampled[n]; w.dstBinding = 0; w.descriptorCount = 1;
+      w.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE; w.pImageInfo = &info[n];
+    }
+    f.vkUpdateDescriptorSets(d, 3, writes, 0, nullptr);
+    initialized = true; return true;
+  }
+  // Source is pinned by the presenter shared_ptr; the existing queue owns it.
+  // The caller retires paint submissions before changing this serial sidecar.
+  bool Record(VkCommandBuffer command, VkImage source, bool generate, bool adaptive_span = false) {
+    const auto& f = device->functions();
+    interpolation.prepare(command);
+    uint32_t next = interpolation.frame_image() == images[0].image ? 0u : 1u;
+    VkImageMemoryBarrier b{}; b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    b.oldLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    b.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = source; b.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT,0,1,0,1};
+    b.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT | VK_ACCESS_MEMORY_READ_BIT;
+    b.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    f.vkCmdPipelineBarrier(command,VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                          VK_PIPELINE_STAGE_TRANSFER_BIT,0,0,nullptr,0,nullptr,1,&b);
+    // Retired prior submissions still need an execution/memory dependency.
+    VkMemoryBarrier reuse{}; reuse.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+    reuse.srcAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    reuse.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT |
+                          VK_ACCESS_SHADER_WRITE_BIT;
+    f.vkCmdPipelineBarrier(command,VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT|VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        0,1,&reuse,0,nullptr,0,nullptr);
+    VkImageCopy copy{}; copy.srcSubresource = copy.dstSubresource =
+        {VK_IMAGE_ASPECT_COLOR_BIT,0,0,1};
+    copy.extent = {extent.width,extent.height,1};
+    copy_image(command,source,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                    images[next].image,VK_IMAGE_LAYOUT_GENERAL,1,&copy);
+    b.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    b.newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    b.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT; b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    f.vkCmdPipelineBarrier(command,VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,0,0,nullptr,0,nullptr,1,&b);
+    VkMemoryBarrier uploaded{}; uploaded.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+    uploaded.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    uploaded.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    f.vkCmdPipelineBarrier(command,VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT|VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+        0,1,&uploaded,0,nullptr,0,nullptr);
+    // Maintain luma/scene history, but don't interpolate unless pacing permits.
+    bool made = false;
+    if (adaptive_span || pacing.Engaged()) {
+      // Modes: the pictures planned for this frame, set before the first is recorded (it is
+      // made a 1 / (pictures + 1) of the way). One, at the middle, unless 3x or 4x applies.
+      // Adaptive pacing sets the count whose fractions its outputs need.
+      interpolation.set_generated(adaptive_span ? std::clamp<uint32_t>(plan.generated, 1, 3)
+                                  : generate ? std::clamp<uint32_t>(pacing.Generated(), 1, 3) : 1);
+      made = interpolation.record(command, !interpolation_history);
+      interpolation_history = true;
+    } else { interpolation_history = false; }
+    const bool generated = generate && history && made;
+    pictures = generated ? interpolation.generated() : 0;
+    acquire_pending = generated || adaptive_span;
+    current = next; history = true;
+    interpolation.advance();
+    if ((new_frames % 120) == 0) {
+      double mean=0,max=0,flow_mean=0; uint32_t count=0;
+      if (interpolation.take_gpu_time(mean,max,count,flow_mean))
+        XELOGW("Framegen GPU cost: mean={}ms max={}ms flow={}ms samples={}",mean,max,flow_mean,count);
+    }
+    return generated;
+  }
+  // 3x and 4x: the next picture between the same two frames (1 to pictures - 1), into the
+  // interpolator's one output image. The paint that samples the picture before it is already
+  // queued ahead of this on the same queue, and the barrier orders the write after it.
+  bool RecordNext(VkCommandBuffer command, uint32_t picture) {
+    VkMemoryBarrier reuse{}; reuse.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+    reuse.srcAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    reuse.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    device->functions().vkCmdPipelineBarrier(command,VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,0,1,&reuse,0,nullptr,0,nullptr);
+    return interpolation.interpolate_next(command, picture);
+  }
+};
+std::mutex framegen_sidecars_mutex;
+std::unordered_map<const void*, std::unique_ptr<FramegenSidecar>> framegen_sidecars;
+FramegenSidecar& GetFramegenSidecar(const void* presenter) {
+  std::lock_guard<std::mutex> lock(framegen_sidecars_mutex);
+  auto& entry = framegen_sidecars[presenter];
+  if (!entry) entry = std::make_unique<FramegenSidecar>();
+  return *entry;
+}
+void EraseFramegenSidecar(const void* presenter) {
+  std::lock_guard<std::mutex> lock(framegen_sidecars_mutex);
+  framegen_sidecars.erase(presenter);
+}
+void DisableFramegenSidecar(const void* presenter) {
+  std::lock_guard<std::mutex> lock(framegen_sidecars_mutex);
+  auto it = framegen_sidecars.find(presenter);
+  if (it != framegen_sidecars.end()) {
+    it->second->display_hz = 0;
+    it->second->pacing.Reset();
+  }
+}
+}  // namespace
+}  // namespace xe::ui::vulkan
