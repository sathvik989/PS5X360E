+dword_result_t PsCamDeviceRequest_entry(dword_t request_ptr) {
+  if (!request_ptr) {
+    return X_STATUS_INVALID_PARAMETER;
+  }
+  if (!xbox360ps5::motion::enabled.load()) return X_STATUS_UNSUCCESSFUL;
+  if (kernel_state()->title_id() != 0x4E4D084E)
+    return X_STATUS_UNSUCCESSFUL;
+  BindSkeletonSource(kernel_state());
+  return GetCameraDevice()->Request(request_ptr);
