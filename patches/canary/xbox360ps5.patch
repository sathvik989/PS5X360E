+xe::memory::PageAccess PhysicalHeap::HostPageWatchLimit(
+    const void* host_page) const {
+  const uintptr_t base = reinterpret_cast<uintptr_t>(membase_) + heap_base_;
+  const uintptr_t at = reinterpret_cast<uintptr_t>(host_page);
+  if (at < base) {
+    return xe::memory::PageAccess::kReadWrite;
+  }
+  const uint64_t system_page = (at - base) >> system_page_shift_;
+  if (system_page >= system_page_count_) {
+    return xe::memory::PageAccess::kReadWrite;
+  }
+  const SystemPageFlagsBlock& flags = system_page_flags_[system_page >> 6];
+  const uint64_t bit = uint64_t(1) << (system_page & 63);
+  if (flags.notify_on_read & bit) {
+    return xe::memory::PageAccess::kNoAccess;
+  }
+  if (flags.notify_on_invalidation & bit) {
+    return xe::memory::PageAccess::kReadOnly;
+  }
+  return xe::memory::PageAccess::kReadWrite;
+}
