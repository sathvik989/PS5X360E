+                                 nullptr) != VK_SUCCESS) {
+    XELOGW("Vulkan cache: snapshot size query failed");
+    return false;
+  }
+  // Pipeline creation threads can grow the cache between the size and data
+  // calls. Bounded allocation and retries; never replace with partial data.
+  for (unsigned attempt = 0; attempt < 4; ++attempt) {
+    if (capacity < 32 || capacity > xbox360ps5::kMaxPipelineCacheBytes) {
+      XELOGW("Vulkan cache: snapshot size {} out of bounds", capacity);
+      return false;
+    }
+    std::vector<uint8_t> data(capacity);
+    size_t written = data.size();
+    VkResult result = dfn.vkGetPipelineCacheData(device, vk_pipeline_cache_,
+                                                 &written, data.data());
+    if (result == VK_SUCCESS) {
+      if (written < 32 || written > data.size()) {
+        return false;
       }
+      const bool saved = xbox360ps5::WriteCacheAtomically(
+          vk_pipeline_cache_path_, data.data(), written);
+      XELOGI("Vulkan cache: title {:08X} snapshot {} bytes at {} {}",
+             shader_storage_title_id_, written,
+             vk_pipeline_cache_path_.string(),
+             saved ? "complete" : "failed (previous file preserved)");
+      return saved;
+    }
+    if (result != VK_INCOMPLETE) {
+      XELOGW("Vulkan cache: snapshot data query failed {}", int(result));
+      return false;
     }
+    size_t required = 0;
+    if (dfn.vkGetPipelineCacheData(device, vk_pipeline_cache_, &required,
+                                   nullptr) != VK_SUCCESS) {
+      return false;
+    }
+    capacity = std::max(required,
+                        std::min(capacity * 2,
+                                 size_t(xbox360ps5::kMaxPipelineCacheBytes)));
+  }
+  XELOGW("Vulkan cache: snapshot still growing after bounded retries");
+  return false;
+} catch (...) {
+  // Allocation, filesystem or logging failures must not unwind shutdown.
+  return false;
+}
+
+void VulkanPipelineCache::ShutdownShaderStorage() {
+  // A save in flight writes the same file.
+  while (pipeline_cache_save_running_.load(std::memory_order_acquire)) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
   }
+  SavePipelineCacheSnapshot();
   vk_pipeline_cache_path_.clear();
 
   // Shut down the storage writer (closes files, stops write thread).
