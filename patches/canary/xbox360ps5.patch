+// SPDX-License-Identifier: MIT
+#include "xenia/ui/controller_keyboard_view.h"
+#include "xenia/base/string.h"
+#include "third_party/imgui/imgui.h"
+
+namespace xe::ui {
+void DrawControllerKeyboard(controller_keyboard::Editor& editor,
+    const std::string& title, const std::string& description, ImGuiIO& io) {
+  // Use a stable, private window ID; guest title text cannot inject ImGui IDs.
+  const float width = std::min(io.DisplaySize.x * 0.94f, 1400.0f);
+  ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * .5f, io.DisplaySize.y * .5f),
+                         ImGuiCond_Always, ImVec2(.5f, .5f));
+  ImGui::SetNextWindowSize(ImVec2(width, 0), ImGuiCond_Always);
+  ImGui::SetNextWindowFocus();
+  constexpr auto flags = ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize |
+      ImGuiWindowFlags_NoMove | ImGuiWindowFlags_AlwaysAutoResize |
+      ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoNavInputs;
+  if (ImGui::Begin("##guest_controller_keyboard", nullptr, flags)) {
+    ImGui::TextUnformatted(title.empty() ? "Keyboard" : title.c_str());
+    ImGui::PushTextWrapPos(0);
+    ImGui::TextUnformatted(description.c_str());
+    ImGui::PopTextWrapPos();
+    ImGui::Separator();
+    auto display = editor.text();
+    display.insert(editor.cursor(), u"|");
+    const auto utf8 = xe::to_utf8(display);
+    // Read only display; editing is exclusively through the controller grid.
+    ImGui::PushTextWrapPos(0);
+    ImGui::TextUnformatted(utf8.c_str());
+    ImGui::PopTextWrapPos();
+    ImGui::Separator();
+    const char* actions[] = {"Space", "Delete", "Shift", "Symbols", "Left",
+                            "Right", "Home", "End", "Cancel", "Done"};
+    const float key_width = (ImGui::GetContentRegionAvail().x - 9 * ImGui::GetStyle().ItemSpacing.x) / 10;
+    const float key_height = ImGui::GetFontSize() * 1.8f;
+    for (int key = 0; key < 50; ++key) {
+      if (key % 10) ImGui::SameLine();
+      ImGui::PushID(key);
+      const bool selected = key == editor.selected();
+      if (selected) ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(.08f, .55f, .32f, 1));
+      std::string label;
+      if (key < 40) label = xe::to_utf8(std::u16string(1, editor.Symbol(key)));
+      else label = actions[key - 40];
+      if (ImGui::Button(label.c_str(), ImVec2(key_width, key_height))) {
+        editor.Select(key); editor.Activate();
+      }
+      if (selected) ImGui::PopStyleColor();
+      ImGui::PopID();
+    }
+    ImGui::Separator();
+    ImGui::TextUnformatted("D-pad / left stick: move   Cross: select   Square: delete");
+    ImGui::TextUnformatted("Triangle: shift   L1 / R1: cursor   OPTIONS: done   Circle: cancel");
+  }
+  ImGui::End();
+}
+}  // namespace xe::ui
