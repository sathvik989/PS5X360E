+  const uint32_t page_first = start >> page_size_log2_;
+  const uint32_t page_last = (start + length - 1) >> page_size_log2_;
+  uint32_t valid = 0, gpu = 0, kept = 0;
+  auto global_lock = global_critical_region_.Acquire();
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    const uint64_t bit = uint64_t(1) << (page & 63);
+    valid += (system_page_flags_valid_[page >> 6] & bit) ? 1 : 0;
+    gpu += (system_page_flags_valid_and_gpu_written_[page >> 6] & bit) ? 1 : 0;
+    kept += kept_pages_.count(page) ? 1 : 0;
