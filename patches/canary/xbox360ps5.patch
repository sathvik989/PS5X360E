+void CommandProcessor::DiagNoteCopyback(const char* what, uint32_t address,
+                                      uint32_t length) {
+  const uint32_t block = diag_wait_block_.load(std::memory_order_relaxed);
+  if (!block || !length || address >= ((block & ~0xFFFu) + 0x1000) ||
+      uint64_t(address) + length <= (block & ~0xFFFu)) {
+    return;
+  }
+  if (diag_copyback_logs_.fetch_add(1, std::memory_order_relaxed) < 32) {
+    XELOGW("GPU: {} 0x{:08X}+0x{:X} overwrites guest RAM in the page of the "
+           "WAIT_REG_MEM marker 0x{:08X}",
+           what, address, length, block);
+  }
+}
+
+void CommandProcessor::DiagDump() {
+  auto name = [](uint32_t opcode) -> const char* {
+    switch (opcode) {
+      case xenos::PM4_INDIRECT_BUFFER:
+      case xenos::PM4_INDIRECT_BUFFER_PFD:
+        return "INDIRECT_BUFFER";
+      case xenos::PM4_WAIT_REG_MEM:
+        return "WAIT_REG_MEM";
+      case xenos::PM4_REG_RMW:
+        return "REG_RMW";
+      case xenos::PM4_REG_TO_MEM:
+        return "REG_TO_MEM";
+      case xenos::PM4_MEM_WRITE:
+        return "MEM_WRITE";
+      case xenos::PM4_COND_WRITE:
+        return "COND_WRITE";
+      case xenos::PM4_EVENT_WRITE:
+        return "EVENT_WRITE";
+      case xenos::PM4_EVENT_WRITE_SHD:
+        return "EVENT_WRITE_SHD";
+      case xenos::PM4_EVENT_WRITE_EXT:
+        return "EVENT_WRITE_EXT";
+      case xenos::PM4_EVENT_WRITE_ZPD:
+        return "EVENT_WRITE_ZPD";
+      case xenos::PM4_INTERRUPT:
+        return "INTERRUPT";
+      case xenos::PM4_XE_SWAP:
+        return "XE_SWAP";
+      case xenos::PM4_DRAW_INDX:
+        return "DRAW_INDX";
+      case xenos::PM4_DRAW_INDX_2:
+        return "DRAW_INDX_2";
+      case 0x100:
+        return "RESOLVE";
+      case 0x101:
+        return "MEMEXPORT";
+      case 0x103:
+        return "WAIT_BEGIN (addr value FFFFFFFF-words)";
+      case 0x104:
+        return "WAIT_DONE (addr microseconds)";
+      default:
+        return "packet";
+    }
+  };
+  auto dump = [&](const char* what, const auto& ring, uint32_t pos) {
+    const uint32_t n = std::min<uint32_t>(pos, uint32_t(ring.size()));
+    XELOGW("GPU: last {} {}, oldest first:", n, what);
+    for (uint32_t i = pos - n; i != pos; ++i) {
+      const DiagPacket& p = ring[i % ring.size()];
+      XELOGW("GPU:   {} {:02X} n{} {:08X} {:08X} {:08X}", name(p.opcode),
+             p.opcode, p.count, p.d0, p.d1, p.d2);
+    }
+  };
+  dump("packets (no constants)", diag_packets_, diag_packets_pos_);
+  dump("memory writes, resolves and interrupts", diag_writes_,
+       diag_writes_pos_);
+}
