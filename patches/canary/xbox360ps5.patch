--- /dev/null
+++ b/src/xenia/ui/shaders/smaa_weights.ps.slang
@@ -0,0 +1,14 @@
+// PS5X360E: SMAA pass 2, blending weights from the edges (texture 0), the area
+// texture (1) and the search texture (2).
+#include "smaa_common.hlsli"
+
+[shader("fragment")]
+float4 main(XeSmaaPixelInput input) : SV_Target0 {
+  float2 texcoord = XeSmaaTexcoord(input.position);
+  float2 pixcoord;
+  float4 offset[3];
+  SMAABlendingWeightCalculationVS(texcoord, pixcoord, offset);
+  return SMAABlendingWeightCalculationPS(texcoord, pixcoord, offset,
+                                         xe_smaa_texture_0, xe_smaa_texture_1,
+                                         xe_smaa_texture_2, float4(0.0, 0.0, 0.0, 0.0));
+}
