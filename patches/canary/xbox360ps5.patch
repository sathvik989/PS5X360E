+void VulkanCommandProcessor::TraceFloatResolveData(uint32_t address,
+                                                   uint32_t length,
+                                                   uint32_t format,
+                                                   uint32_t endian) {
+  // The resolve has to have run: submit it, then copy its output to guest
+  // RAM synchronously (as a CPU read of it would).
+  if (submission_open_) {
+    EndRenderPass();
+    if (!EndSubmission(false)) {
+      return;
+    }
+  }
+  bool copied;
+  {
+    std::lock_guard<std::mutex> lock(resolve_read_mutex_);
+    copied = FaultCopyResolveToGuestRam({{address, length}});
+  }
+  if (!copied) {
+    XELOGW("FT {} DATA {:08X} copy failed",
+           frame_trace_frame.load(std::memory_order_relaxed), address);
+    return;
+  }
+  const uint8_t* bytes = memory_->TranslatePhysical<const uint8_t*>(address);
+  const bool half = format == 32;
+  const uint32_t channels = format == 36 ? 1 : 4;
+  const uint32_t element_size = half ? 2 : 4;
+  const uint32_t count = length / element_size;
+  auto load = [&](uint32_t i) -> float {
+    const uint8_t* p = bytes + size_t(i) * element_size;
+    uint32_t v;
+    if (half) {
+      // Read as big-endian halves (8in16), the common case; the log names
+      // the endian mode.
+      uint16_t h = uint16_t(uint16_t(p[0]) << 8 | p[1]);
+      uint32_t sign = uint32_t(h >> 15) << 31;
+      uint32_t exponent = (h >> 10) & 0x1F, mantissa = h & 0x3FF;
+      float f;
+      if (exponent == 0) {
+        f = std::ldexp(float(mantissa), -24);
+        std::memcpy(&v, &f, 4);
+        v |= sign;
+      } else if (exponent == 31) {
+        v = sign | 0x7F800000u | (mantissa << 13);
+      } else {
+        v = sign | ((exponent + 112) << 23) | (mantissa << 13);
+      }
+      std::memcpy(&f, &v, 4);
+      return f;
+    }
+    std::memcpy(&v, p, 4);
+    if (endian == 2) {
+      v = xe::byte_swap(v);
+    } else if (endian == 1) {
+      v = ((v & 0x00FF00FFu) << 8) | ((v >> 8) & 0x00FF00FFu);
+    } else if (endian == 3) {
+      v = (v << 16) | (v >> 16);
+    }
+    float f;
+    std::memcpy(&f, &v, 4);
+    return f;
+  };
+  std::string summary;
+  uint64_t hash = 1469598103934665603ull;
+  for (uint32_t c = 0; c < channels; ++c) {
+    uint32_t nans = 0, infs = 0, zeros = 0, n = 0;
+    float lo = 0.0f, hi = 0.0f;
+    double sum = 0.0;
+    for (uint32_t i = c; i < count; i += channels) {
+      float f = load(i);
+      uint32_t bits;
+      std::memcpy(&bits, &f, 4);
+      hash = (hash ^ bits) * 1099511628211ull;
+      if (std::isnan(f)) {
+        ++nans;
+        continue;
+      }
+      if (std::isinf(f)) {
+        ++infs;
+        continue;
+      }
+      if (f == 0.0f) {
+        ++zeros;
+      }
+      lo = n ? std::min(lo, f) : f;
+      hi = n ? std::max(hi, f) : f;
+      sum += f;
+      ++n;
+    }
+    summary += fmt::format(" | c{} min {:.4g} max {:.4g} mean {:.4g} zero {} "
+                           "nan {} inf {}",
+                           c, lo, hi, n ? sum / n : 0.0, zeros, nans, infs);
+  }
+  XELOGW("FT {} DATA {:08X} {} fmt {} endian {} hash {:016X}{}",
+         frame_trace_frame.load(std::memory_order_relaxed), address, length,
+         format, endian, hash, summary);
+}
