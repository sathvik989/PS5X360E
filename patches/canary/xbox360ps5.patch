+namespace ps5x360::sword_dispatch {
+bool Bind(VkInstance instance, VkDevice device, PFN_vkGetInstanceProcAddr get) {
+auto gd = reinterpret_cast<PFN_vkGetDeviceProcAddr>(get(instance,"vkGetDeviceProcAddr")); if (!gd) return false;
+vkAllocateDescriptorSets = reinterpret_cast<PFN_vkAllocateDescriptorSets>(gd(device,"vkAllocateDescriptorSets")); if (!vkAllocateDescriptorSets) return false;
+vkAllocateMemory = reinterpret_cast<PFN_vkAllocateMemory>(gd(device,"vkAllocateMemory")); if (!vkAllocateMemory) return false;
+vkBindBufferMemory = reinterpret_cast<PFN_vkBindBufferMemory>(gd(device,"vkBindBufferMemory")); if (!vkBindBufferMemory) return false;
+vkBindImageMemory = reinterpret_cast<PFN_vkBindImageMemory>(gd(device,"vkBindImageMemory")); if (!vkBindImageMemory) return false;
+vkCmdBindDescriptorSets = reinterpret_cast<PFN_vkCmdBindDescriptorSets>(gd(device,"vkCmdBindDescriptorSets")); if (!vkCmdBindDescriptorSets) return false;
+vkCmdBindPipeline = reinterpret_cast<PFN_vkCmdBindPipeline>(gd(device,"vkCmdBindPipeline")); if (!vkCmdBindPipeline) return false;
+vkCmdClearColorImage = reinterpret_cast<PFN_vkCmdClearColorImage>(gd(device,"vkCmdClearColorImage")); if (!vkCmdClearColorImage) return false;
+vkCmdDispatch = reinterpret_cast<PFN_vkCmdDispatch>(gd(device,"vkCmdDispatch")); if (!vkCmdDispatch) return false;
+vkCmdFillBuffer = reinterpret_cast<PFN_vkCmdFillBuffer>(gd(device,"vkCmdFillBuffer")); if (!vkCmdFillBuffer) return false;
+vkCmdPipelineBarrier = reinterpret_cast<PFN_vkCmdPipelineBarrier>(gd(device,"vkCmdPipelineBarrier")); if (!vkCmdPipelineBarrier) return false;
+vkCmdResetQueryPool = reinterpret_cast<PFN_vkCmdResetQueryPool>(gd(device,"vkCmdResetQueryPool")); if (!vkCmdResetQueryPool) return false;
+vkCreateBuffer = reinterpret_cast<PFN_vkCreateBuffer>(gd(device,"vkCreateBuffer")); if (!vkCreateBuffer) return false;
+vkCreateComputePipelines = reinterpret_cast<PFN_vkCreateComputePipelines>(gd(device,"vkCreateComputePipelines")); if (!vkCreateComputePipelines) return false;
+vkCreateDescriptorPool = reinterpret_cast<PFN_vkCreateDescriptorPool>(gd(device,"vkCreateDescriptorPool")); if (!vkCreateDescriptorPool) return false;
+vkCreateDescriptorSetLayout = reinterpret_cast<PFN_vkCreateDescriptorSetLayout>(gd(device,"vkCreateDescriptorSetLayout")); if (!vkCreateDescriptorSetLayout) return false;
+vkCreateImage = reinterpret_cast<PFN_vkCreateImage>(gd(device,"vkCreateImage")); if (!vkCreateImage) return false;
+vkCreateImageView = reinterpret_cast<PFN_vkCreateImageView>(gd(device,"vkCreateImageView")); if (!vkCreateImageView) return false;
+vkCreatePipelineLayout = reinterpret_cast<PFN_vkCreatePipelineLayout>(gd(device,"vkCreatePipelineLayout")); if (!vkCreatePipelineLayout) return false;
+vkCreateQueryPool = reinterpret_cast<PFN_vkCreateQueryPool>(gd(device,"vkCreateQueryPool")); if (!vkCreateQueryPool) return false;
+vkCreateSampler = reinterpret_cast<PFN_vkCreateSampler>(gd(device,"vkCreateSampler")); if (!vkCreateSampler) return false;
+vkCreateShaderModule = reinterpret_cast<PFN_vkCreateShaderModule>(gd(device,"vkCreateShaderModule")); if (!vkCreateShaderModule) return false;
+vkDestroyBuffer = reinterpret_cast<PFN_vkDestroyBuffer>(gd(device,"vkDestroyBuffer")); if (!vkDestroyBuffer) return false;
+vkDestroyDescriptorPool = reinterpret_cast<PFN_vkDestroyDescriptorPool>(gd(device,"vkDestroyDescriptorPool")); if (!vkDestroyDescriptorPool) return false;
+vkDestroyDescriptorSetLayout = reinterpret_cast<PFN_vkDestroyDescriptorSetLayout>(gd(device,"vkDestroyDescriptorSetLayout")); if (!vkDestroyDescriptorSetLayout) return false;
+vkDestroyImage = reinterpret_cast<PFN_vkDestroyImage>(gd(device,"vkDestroyImage")); if (!vkDestroyImage) return false;
+vkDestroyImageView = reinterpret_cast<PFN_vkDestroyImageView>(gd(device,"vkDestroyImageView")); if (!vkDestroyImageView) return false;
+vkDestroyPipeline = reinterpret_cast<PFN_vkDestroyPipeline>(gd(device,"vkDestroyPipeline")); if (!vkDestroyPipeline) return false;
+vkDestroyPipelineLayout = reinterpret_cast<PFN_vkDestroyPipelineLayout>(gd(device,"vkDestroyPipelineLayout")); if (!vkDestroyPipelineLayout) return false;
+vkDestroyQueryPool = reinterpret_cast<PFN_vkDestroyQueryPool>(gd(device,"vkDestroyQueryPool")); if (!vkDestroyQueryPool) return false;
+vkDestroySampler = reinterpret_cast<PFN_vkDestroySampler>(gd(device,"vkDestroySampler")); if (!vkDestroySampler) return false;
+vkDestroyShaderModule = reinterpret_cast<PFN_vkDestroyShaderModule>(gd(device,"vkDestroyShaderModule")); if (!vkDestroyShaderModule) return false;
+vkFreeMemory = reinterpret_cast<PFN_vkFreeMemory>(gd(device,"vkFreeMemory")); if (!vkFreeMemory) return false;
+vkGetBufferMemoryRequirements = reinterpret_cast<PFN_vkGetBufferMemoryRequirements>(gd(device,"vkGetBufferMemoryRequirements")); if (!vkGetBufferMemoryRequirements) return false;
+vkGetDeviceProcAddr = reinterpret_cast<PFN_vkGetDeviceProcAddr>(get(instance,"vkGetDeviceProcAddr")); if (!vkGetDeviceProcAddr) return false;
+vkGetImageMemoryRequirements = reinterpret_cast<PFN_vkGetImageMemoryRequirements>(gd(device,"vkGetImageMemoryRequirements")); if (!vkGetImageMemoryRequirements) return false;
+vkGetPhysicalDeviceMemoryProperties = reinterpret_cast<PFN_vkGetPhysicalDeviceMemoryProperties>(get(instance,"vkGetPhysicalDeviceMemoryProperties")); if (!vkGetPhysicalDeviceMemoryProperties) return false;
+vkGetPhysicalDeviceProperties = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties>(get(instance,"vkGetPhysicalDeviceProperties")); if (!vkGetPhysicalDeviceProperties) return false;
+vkGetQueryPoolResults = reinterpret_cast<PFN_vkGetQueryPoolResults>(gd(device,"vkGetQueryPoolResults")); if (!vkGetQueryPoolResults) return false;
+vkMapMemory = reinterpret_cast<PFN_vkMapMemory>(gd(device,"vkMapMemory")); if (!vkMapMemory) return false;
+vkUnmapMemory = reinterpret_cast<PFN_vkUnmapMemory>(gd(device,"vkUnmapMemory")); if (!vkUnmapMemory) return false;
