diff --git a/src/xenia/ui/vulkan/vulkan_presenter.h b/src/xenia/ui/vulkan/vulkan_presenter.h
index fa151fb4c..2880f68af 100644
--- a/src/xenia/ui/vulkan/vulkan_presenter.h
+++ b/src/xenia/ui/vulkan/vulkan_presenter.h
@@ -501,6 +501,73 @@ class VulkanPresenter final : public Presenter {
   // DisconnectPaintingFromSurfaceFromUIThreadImpl) by the thread doing it, as
   // well as by presenter initialization and shutdown.
   PaintContext paint_context_;
+
+  // PS5X360E: SMAA 1x on the guest output before the scaling and sharpening
+  // effects (shaders/smaa_common.hlsli). Painting only, like paint_context_.
+  struct Smaa {
+    bool init_attempted = false;
+    bool ready = false;
+    VkDescriptorSetLayout set_layout = VK_NULL_HANDLE;
+    VkPipelineLayout pipeline_layout = VK_NULL_HANDLE;
+    VkShaderModule vs = VK_NULL_HANDLE;
+    // Edges, weights, blend, FXAA.
+    std::array<VkShaderModule, 4> fs = {};
+    // R8G8B8A8 cleared (edges, weights).
+    VkRenderPass pass_rgba8 = VK_NULL_HANDLE;
+    // Edges, weights, blend, FXAA (the last two into the intermediate render
+    // pass).
+    std::array<VkPipeline, 4> pipelines = {};
+    VkImage area_image = VK_NULL_HANDLE, search_image = VK_NULL_HANDLE;
+    VkDeviceMemory area_memory = VK_NULL_HANDLE,
+                   search_memory = VK_NULL_HANDLE;
+    VkImageView area_view = VK_NULL_HANDLE, search_view = VK_NULL_HANDLE;
+    VkBuffer upload_buffer = VK_NULL_HANDLE;
+    VkDeviceMemory upload_memory = VK_NULL_HANDLE;
+    bool lookup_uploaded = false;
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    // Per guest output image paint reference: edges (guest output) and blend
+    // (guest output, weights) sets.
+    std::array<VkDescriptorSet, kGuestOutputMailboxSize> edges_sets = {};
+    std::array<VkDescriptorSet, kGuestOutputMailboxSize> blend_sets = {};
+    std::array<bool, kGuestOutputMailboxSize> ref_dirty = {};
+    VkDescriptorSet weights_set = VK_NULL_HANDLE;
+    // In guest_output_paint_image_descriptor_set_layout_, for the first effect.
+    VkDescriptorSet output_set = VK_NULL_HANDLE;
+    // The same, of the edges, to show them.
+    VkDescriptorSet edges_output_set = VK_NULL_HANDLE;
+    // FXAA's source, the SMAA output or the guest output of a paint
+    // reference, and its output for the effects.
+    VkDescriptorSet fxaa_from_smaa_set = VK_NULL_HANDLE;
+    std::array<VkDescriptorSet, kGuestOutputMailboxSize> fxaa_from_guest_sets =
+        {};
+    VkDescriptorSet fxaa_output_set = VK_NULL_HANDLE;
+    // Sized like the guest output.
+    VkExtent2D extent = {};
+    VkImage edges_image = VK_NULL_HANDLE, weights_image = VK_NULL_HANDLE;
+    VkDeviceMemory edges_memory = VK_NULL_HANDLE,
+                   weights_memory = VK_NULL_HANDLE;
