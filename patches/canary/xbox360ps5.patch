+// PsCam ABI adapted from knuckleslee Xenia Canary PR 1274 (BSD).
+// PS5 research source rasterizes estimated poses; no USB camera is used.
+// Original calibration math reference is libfreenect
+// (src/registration.c, Apache-2.0).
+
+#include <algorithm>
+#include <atomic>
