+	{"of_luma_pyramid", k_fg_spv_of_luma_pyramid, 9787, {256, 1, 1}, k_fg_bind_of_luma_pyramid, 9},
+	{"of_scd_histogram", k_fg_spv_of_scd_histogram, 2006, {32, 8, 1}, k_fg_bind_of_scd_histogram, 3},
