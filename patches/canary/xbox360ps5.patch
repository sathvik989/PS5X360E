+std::string VulkanCommandProcessor::TakePerformanceSummary() {
+  const uint64_t now = PerfNowNs();
+  const uint64_t since = perf_summary_ns_.exchange(now);
+  if (!since || now <= since) {
+    // First call: start the window.
+    for (auto& counter : perf_submits_) counter.store(0);
+    for (auto& counter : perf_waits_) counter.store(0);
+    for (auto& counter : perf_wait_ns_) counter.store(0);
+    perf_gpu_busy_ns_.store(0);
+    perf_gpu_timed_.store(0);
+    perf_gpu_untimed_.store(0);
+    perf_async_readbacks_.store(0);
+    perf_draws_previous_ = perf_draws_.load(std::memory_order_relaxed);
+    perf_thread_cpu_previous_ns_ =
+        perf_thread_cpu_ns_.load(std::memory_order_relaxed);
+    return {};
+  }
+  const double seconds = double(now - since) / 1e9;
+  uint64_t submits[uint32_t(SubmitReason::kCount)], total_submits = 0;
+  for (uint32_t i = 0; i < uint32_t(SubmitReason::kCount); ++i) {
+    submits[i] = perf_submits_[i].exchange(0);
+    total_submits += submits[i];
+  }
+  uint64_t waits[uint32_t(WaitReason::kCount)];
+  uint64_t wait_ns[uint32_t(WaitReason::kCount)];
+  for (uint32_t i = 0; i < uint32_t(WaitReason::kCount); ++i) {
+    waits[i] = perf_waits_[i].exchange(0);
+    wait_ns[i] = perf_wait_ns_[i].exchange(0);
+  }
+  const uint64_t busy = perf_gpu_busy_ns_.exchange(0);
+  const uint64_t async_readbacks = perf_async_readbacks_.exchange(0);
+  const uint64_t timed = perf_gpu_timed_.exchange(0);
+  const uint64_t untimed = perf_gpu_untimed_.exchange(0);
+  auto per_s = [&](uint64_t v) { return double(v) / seconds; };
+  auto ms_per_s = [&](uint64_t ns) { return double(ns) / 1e6 / seconds; };
+  const uint64_t draws = perf_draws_.load(std::memory_order_relaxed);
+  const uint64_t thread_cpu_ns =
+      perf_thread_cpu_ns_.load(std::memory_order_relaxed);
+  const uint64_t window_draws = draws - perf_draws_previous_;
+  const uint64_t window_thread_cpu_ns =
+      thread_cpu_ns >= perf_thread_cpu_previous_ns_
+          ? thread_cpu_ns - perf_thread_cpu_previous_ns_
+          : 0;
+  perf_draws_previous_ = draws;
+  perf_thread_cpu_previous_ns_ = thread_cpu_ns;
+  const uint64_t draw_samples = perf_draw_samples_.load(std::memory_order_relaxed);
+  const uint64_t window_draw_samples = draw_samples - perf_draw_samples_previous_;
+  perf_draw_samples_previous_ = draw_samples;
+  std::string draw_stages;
+  {
+    static const char* const kStageNames[kDrawStages] = {
+        "shaders", "render targets", "pipeline", "textures",
+        "state",   "bindings",       "memory",   "draw"};
+    double total_us = 0;
+    std::string parts;
+    for (uint32_t i = 0; i < kDrawStages; ++i) {
+      const uint64_t stage_ns =
+          perf_draw_stage_ns_[i].load(std::memory_order_relaxed);
+      const uint64_t window_ns = stage_ns - perf_draw_stage_previous_ns_[i];
+      perf_draw_stage_previous_ns_[i] = stage_ns;
+      if (!window_draw_samples) {
+        continue;
+      }
+      const double us = double(window_ns) / 1000.0 / double(window_draw_samples);
+      total_us += us;
+      parts += fmt::format("{}{} {:.2f}", parts.empty() ? "" : ", ",
+                           kStageNames[i], us);
+    }
+    if (window_draw_samples) {
+      draw_stages = fmt::format(
+          "; per draw {:.2f} us in IssueDraw ({}; {} sampled)", total_us,
+          parts, window_draw_samples);
+    }
+  }
+  std::string thread_cpu =
+      thread_cpu_ns ? fmt::format("{:.0f}%", 100.0 *
+                                                 double(window_thread_cpu_ns) /
+                                                 double(now - since))
+                    : std::string("n/a");
+  return fmt::format(
+      "draws {:.0f}/s, command processor thread CPU {}{}; "
+      "GPU busy {:.0f}% ({:.1f} ms/s over {} timed submissions, {} untimed); "
+      "submissions {:.0f}/s: swap {:.0f}, guest buffer end {:.0f}, resolve "
+      "sync {:.0f}, occlusion query {:.0f}, wait {:.0f}, other {:.0f}; GPU "
+      "waits: occlusion query {:.0f}/s {:.1f} ms/s, frames in flight {:.0f}/s "
+      "{:.1f} ms/s, export output for the guest {:.0f}/s {:.1f} ms/s, other "
+      "{:.0f}/s {:.1f} ms/s, resolve read by CPU {:.0f}/s {:.1f} ms/s; render "
+      "output copied for the CPU without waiting {:.0f}/s",
+      per_s(window_draws), thread_cpu, draw_stages,
+      100.0 * double(busy) / double(now - since), ms_per_s(busy), timed,
+      untimed, per_s(total_submits),
+      per_s(submits[uint32_t(SubmitReason::kSwap)]),
+      per_s(submits[uint32_t(SubmitReason::kPrimaryBufferEnd)]),
+      per_s(submits[uint32_t(SubmitReason::kResolveSync)]),
+      per_s(submits[uint32_t(SubmitReason::kQuery)]),
+      per_s(submits[uint32_t(SubmitReason::kAwait)]),
+      per_s(submits[uint32_t(SubmitReason::kOther)]),
+      per_s(waits[uint32_t(WaitReason::kQuery)]),
+      ms_per_s(wait_ns[uint32_t(WaitReason::kQuery)]),
+      per_s(waits[uint32_t(WaitReason::kFrame)]),
+      ms_per_s(wait_ns[uint32_t(WaitReason::kFrame)]),
+      per_s(waits[uint32_t(WaitReason::kMemexport)]),
+      ms_per_s(wait_ns[uint32_t(WaitReason::kMemexport)]),
+      per_s(waits[uint32_t(WaitReason::kOther)]),
+      ms_per_s(wait_ns[uint32_t(WaitReason::kOther)]),
+      per_s(waits[uint32_t(WaitReason::kFaultCopy)]),
+      ms_per_s(wait_ns[uint32_t(WaitReason::kFaultCopy)]),
+      per_s(async_readbacks));
+}
