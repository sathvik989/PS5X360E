@@ -0,0 +1,11 @@
+// PS5X360E: SMAA pass 1, luma edge detection of the guest output.
+#include "smaa_common.hlsli"
+
+[shader("fragment")]
+float4 main(XeSmaaPixelInput input) : SV_Target0 {
+  float2 texcoord = XeSmaaTexcoord(input.position);
+  float4 offset[3];
+  SMAAEdgeDetectionVS(texcoord, offset);
+  return float4(SMAALumaEdgeDetectionPS(texcoord, offset, xe_smaa_texture_0),
+                0.0, 0.0);
+}
