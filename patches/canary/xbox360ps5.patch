+  perf_waits_[uint32_t(reason)].fetch_add(1, std::memory_order_relaxed);
+  perf_wait_ns_[uint32_t(reason)].fetch_add(
+      PerfNowNs() - start,
+      std::memory_order_relaxed);
+}
