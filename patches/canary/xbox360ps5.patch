+void VulkanCommandProcessor::AwaitSubmissionCounted(uint64_t submission,
+                                                    WaitReason reason) {
+  if (submission <= GetCompletedSubmission()) {
+    completion_timeline_.AwaitSubmissionAndUpdateCompleted(submission);
+    return;
+  }
+  const uint64_t start = PerfNowNs();
+  completion_timeline_.AwaitSubmissionAndUpdateCompleted(submission);
+  perf_waits_[uint32_t(reason)].fetch_add(1, std::memory_order_relaxed);
+  perf_wait_ns_[uint32_t(reason)].fetch_add(
+      PerfNowNs() - start,
+      std::memory_order_relaxed);
+}
