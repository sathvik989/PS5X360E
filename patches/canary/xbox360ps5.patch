+// SPDX-License-Identifier: MIT
+#include "xenia/ui/controller_keyboard_dialog.h"
+#include "xenia/ui/controller_keyboard_view.h"
+#include "xenia/base/string.h"
+#include "third_party/imgui/imgui.h"
+
+namespace xe::ui {
+ControllerKeyboardDialog::ControllerKeyboardDialog(ImGuiDrawer* drawer,
+    std::string title, std::string description, std::u16string initial,
+    size_t capacity, std::shared_ptr<ControllerKeyboardCompletion> completion)
+    : ImGuiDialog(drawer), title_(std::move(title)), description_(std::move(description)),
+      editor_(std::move(initial), capacity), completion_(std::move(completion)) {}
+
+ControllerKeyboardDialog::~ControllerKeyboardDialog() {
+  // The base destructor signals the waiting fence AFTER publishing this result.
+  completion_->result = editor_.result() == controller_keyboard::Result::accepted
+      ? controller_keyboard::Result::accepted : controller_keyboard::Result::cancelled;
+  if (completion_->result == controller_keyboard::Result::accepted)
+    completion_->text = editor_.text();
+  controller_keyboard::Bridge().End();
+}
+
+void ControllerKeyboardDialog::OnDraw(ImGuiIO& io) {
+  if (controller_keyboard::Bridge().cancelled()) {
+    editor_.Finish(controller_keyboard::Result::cancelled);
+    Close();
+    return;
+  }
+  editor_.Press(controller_keyboard::Bridge().TakePressed());
+  DrawControllerKeyboard(editor_, title_, description_, io);
+  if (editor_.result() != controller_keyboard::Result::pending) Close();
+}
+
+}  // namespace xe::ui
