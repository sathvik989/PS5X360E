+// PS5X360E: one triangle covering the target, for the SMAA passes.
+
+struct XeSmaaVertexOutput {
+  float4 position : SV_Position;
+};
+
+[shader("vertex")]
+XeSmaaVertexOutput main(uint vertex_id : SV_VertexID) {
+  XeSmaaVertexOutput output;
+  float2 corner = float2(float((vertex_id << 1u) & 2u), float(vertex_id & 2u));
+  output.position = float4(corner * 2.0 - 1.0, 0.0, 1.0);
+  return output;
+}
diff --git a/src/xenia/ui/shaders/smaa_weights.ps.slang b/src/xenia/ui/shaders/smaa_weights.ps.slang
