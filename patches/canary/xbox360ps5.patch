+namespace xe::gpu {
+// PS5X360E: frames left to trace (resolves and texture loads, one line each),
+// armed by the guide's performance measurement; and the frame being traced.
+inline std::atomic<uint32_t> frame_trace_frames_left{0};
+inline std::atomic<uint32_t> frame_trace_frame{0};
+inline std::atomic<uint32_t> frame_trace_lines{0};
+inline bool FrameTraceLine() {
+  return frame_trace_frames_left.load(std::memory_order_relaxed) &&
+         frame_trace_lines.fetch_add(1, std::memory_order_relaxed) < 6000;
