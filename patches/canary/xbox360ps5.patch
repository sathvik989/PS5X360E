+
+void SharedMemory::VerifyKeptGpuWrittenPages() {
+  if (kept_page_count_.load(std::memory_order_relaxed)) {
+    VerifyKeptGpuWrittenPages(0, UINT32_MAX);
+  }
+  static uint32_t frames = 0;
+  if (++frames % 1800 == 0 && kept_pages_total_) {
+    XELOGW(
+        "Shared memory: {} guest pages of GPU output kept through CPU writes "
+        "elsewhere in their 16 KiB host page, {} of them later written by the "
+        "CPU",
+        kept_pages_total_, kept_pages_written_);
+  }
+}
+
+void SharedMemory::VerifyKeptGpuWrittenPages(uint32_t page_first,
+                                             uint32_t page_last) {
+  std::vector<uint32_t> rewatch;
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    for (auto it = kept_pages_.begin(); it != kept_pages_.end();) {
+      const uint32_t page = it->first;
+      if (page < page_first || page > page_last) {
+        ++it;
+        continue;
+      }
+      const void* guest = memory_.TranslatePhysical(page << page_size_log2_);
+      const uint64_t hash =
+          guest ? XXH3_64bits(guest, size_t(1) << page_size_log2_) : 0;
+      if (hash != it->second) {
+        // The CPU wrote it while unwatched: guest RAM is current.
+        const uint64_t bit = uint64_t(1) << (page & 63);
+        system_page_flags_valid_[page >> 6] &= ~bit;
+        system_page_flags_valid_and_gpu_written_[page >> 6] &= ~bit;
+        gpu_written_data_dirty_ = true;
+        dirty_blocks_ |= 1u << ((page >> 6) >> 6);
+        FireWatches(page, page, false);
+        ++kept_pages_written_;
+      } else {
+        rewatch.push_back(page);
+      }
+      it = kept_pages_.erase(it);
+    }
+    kept_page_count_.store(uint32_t(kept_pages_.size()),
+                           std::memory_order_relaxed);
+  }
+  for (uint32_t page : rewatch) {
+    memory().EnablePhysicalMemoryAccessCallbacks(
+        page << page_size_log2_, uint32_t(1) << page_size_log2_, true, false);
+  }
+}
