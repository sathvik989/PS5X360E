+std::optional<GdfxFileLocation> FindXboxOriginalXbe(
+    const std::filesystem::path& path) {
+  auto file = xe::filesystem::FileHandle::OpenExisting(
+      path, xe::filesystem::FileAccess::kGenericRead);
+  std::error_code size_error;
+  const uint64_t size = std::filesystem::file_size(path, size_error);
+  if (!file || size_error) {
+    return std::nullopt;
+  }
+  auto read = [&file, size](size_t offset, void* buffer, size_t length) {
+    size_t bytes_read = 0;
+    return offset <= size && size - offset >= length &&
+           file->Read(offset, buffer, length, &bytes_read) &&
+           bytes_read == length;
+  };
+  // As GdfxFindPartition: the first likely offset with the magic at sector 32
+  // and a sane root directory.
+  for (size_t offset : kGdfxLikelyOffsets) {
+    uint8_t header[28];
+    if (!read(offset + 32 * kGdfxSectorSize, header, sizeof(header)) ||
+        std::memcmp(header, kGdfxMagic, kGdfxMagicSize) != 0) {
+      continue;
+    }
+    const uint32_t root_sector = xe::load<uint32_t>(header + 20);
+    const uint32_t root_size = xe::load<uint32_t>(header + 24);
+    if (root_size < 13 || root_size > 32 * 1024 * 1024) {
+      continue;
+    }
+    std::vector<uint8_t> root(root_size);
+    if (!read(offset + size_t(root_sector) * kGdfxSectorSize, root.data(),
+              root.size())) {
+      return std::nullopt;
+    }
+    auto find = [&](const char* name) {
+      return detail::GdfxFindFileInDirectory(nullptr, size_t(size), offset,
+                                             root.data(), root.size(), 0, name,
+                                             std::strlen(name), 0);
+    };
+    if (find("default.xex")) {
+      return std::nullopt;
+    }
+    auto location = find("default.xbe");
+    if (!location || location->offset > size ||
+        size - location->offset < location->length) {
+      return std::nullopt;
+    }
+    return location;
+  }
+  return std::nullopt;
+}
