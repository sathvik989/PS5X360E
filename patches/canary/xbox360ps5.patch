+std::unique_ptr<DeferredCommandBuffer>
+VulkanCommandProcessor::TakeFreeDeferredCommandBuffer() {
+  {
+    std::lock_guard<std::mutex> lock(submit_mutex_);
+    if (!deferred_free_.empty()) {
+      std::unique_ptr<DeferredCommandBuffer> deferred =
+          std::move(deferred_free_.back());
+      deferred_free_.pop_back();
+      return deferred;
+    }
+  }
+  return std::make_unique<DeferredCommandBuffer>(*this);
+}
+
+bool VulkanCommandProcessor::RunSubmitJob(SubmitJob& job) {
+  ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkCommandBufferBeginInfo begin_info = {
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  bool recorded =
+      dfn.vkBeginCommandBuffer(job.command_buffer.buffer, &begin_info) ==
+      VK_SUCCESS;
+  if (recorded) {
+    if (job.gpu_time_recorded) {
+      dfn.vkCmdResetQueryPool(job.command_buffer.buffer, gpu_time_query_pool_,
+                              job.gpu_time_slot * 2, 2);
+      dfn.vkCmdWriteTimestamp(job.command_buffer.buffer,
+                              VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                              gpu_time_query_pool_, job.gpu_time_slot * 2);
+    }
+    job.deferred->Execute(job.command_buffer.buffer);
+    recorded =
+        dfn.vkEndCommandBuffer(job.command_buffer.buffer) == VK_SUCCESS;
+  }
+  job.deferred->Reset();
+  {
+    std::lock_guard<std::mutex> lock(submit_mutex_);
+    deferred_free_.push_back(std::move(job.deferred));
+  }
+  VkResult submit_result = VK_ERROR_INITIALIZATION_FAILED;
+  {
+    ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+        vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(),
+                                    0);
+    if (recorded) {
+      const VkCommandBuffer command_buffers[] = {job.command_buffer.buffer,
+                                                 job.command_buffer.tail};
+      VkSubmitInfo submit_info = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+      if (!job.wait_semaphores.empty()) {
+        submit_info.waitSemaphoreCount = uint32_t(job.wait_semaphores.size());
+        submit_info.pWaitSemaphores = job.wait_semaphores.data();
+        submit_info.pWaitDstStageMask = job.wait_stage_masks.data();
+      }
+      submit_info.commandBufferCount = 2;
+      submit_info.pCommandBuffers = command_buffers;
+      submit_result = vulkan_device->SubmitAndUpdateLost(
+          queue_acquisition.queue(), 1, &submit_info, job.fence);
+    }
+    if (submit_result != VK_SUCCESS && !vulkan_device->IsLost()) {
+      // Signal the fence anyway, so nothing waits for it forever.
+      dfn.vkQueueSubmit(queue_acquisition.queue(), 0, nullptr, job.fence);
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lock(submit_mutex_);
+    queue_submitted_through_.store(job.submission_index,
+                                   std::memory_order_release);
+  }
+  submit_done_cv_.notify_all();
+  if (submit_result != VK_SUCCESS) {
+    XELOGE(
+        "VulkanCommandProcessor: Failed to submit a Vulkan command buffer - "
+        "VkResult: {} (0x{:08X}), submission: {}{}",
+        static_cast<int32_t>(submit_result),
+        static_cast<uint32_t>(submit_result), job.submission_index,
+        recorded ? "" : " (recording failed)");
+    if (submit_result == VK_ERROR_DEVICE_LOST) {
+      XELOGE(
+          "VK_ERROR_DEVICE_LOST - GPU crashed or hung. This may be caused by "
+          "an invalid shader, out-of-bounds memory access, or driver bug.");
+    }
+    return false;
+  }
+  return true;
+}
+
+void VulkanCommandProcessor::SubmitThreadMain() {
+  while (true) {
+    SubmitJob job;
+    {
+      std::unique_lock<std::mutex> lock(submit_mutex_);
+      submit_work_cv_.wait(lock, [this] {
+        return submit_thread_stop_ || !submit_queue_.empty();
+      });
+      if (submit_queue_.empty()) {
+        return;
+      }
+      job = std::move(submit_queue_.front());
+      submit_queue_.pop_front();
+    }
+    submit_done_cv_.notify_all();
+    if (!RunSubmitJob(job) && GetVulkanDevice()->IsLost()) {
+      graphics_system_->OnHostGpuLossFromAnyThread(true);
+    }
+  }
+}
+
+void VulkanCommandProcessor::StartSubmitThread() {
+  if (submit_thread_running_ || !cvars::vulkan_async_submission) {
+    return;
+  }
+  submit_thread_stop_ = false;
+  queue_submitted_through_.store(GetCurrentSubmission() - 1,
+                                 std::memory_order_relaxed);
+  submit_thread_ = std::thread([this] { SubmitThreadMain(); });
+  submit_thread_running_ = true;
+  XELOGI("VulkanCommandProcessor: submissions handed to the queue on their own "
+         "thread");
+}
+
+void VulkanCommandProcessor::StopSubmitThread() {
+  if (!submit_thread_running_) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(submit_mutex_);
+    submit_thread_stop_ = true;
+  }
+  submit_work_cv_.notify_all();
+  submit_thread_.join();
+  submit_thread_running_ = false;
+}
+
+void VulkanCommandProcessor::WaitQueueSubmittedThrough(uint64_t submission) {
+  if (!submit_thread_running_ ||
+      queue_submitted_through_.load(std::memory_order_acquire) >= submission) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(submit_mutex_);
+  submit_done_cv_.wait(lock, [this, submission] {
+    return queue_submitted_through_.load(std::memory_order_acquire) >=
+           submission;
+  });
+}
