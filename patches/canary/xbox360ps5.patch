diff --git a/src/xenia/ui/shaders/post_fxaa.ps.slang b/src/xenia/ui/shaders/post_fxaa.ps.slang
new file mode 100644
index 000000000..74595c091
--- /dev/null
+++ b/src/xenia/ui/shaders/post_fxaa.ps.slang
@@ -0,0 +1,45 @@
+// PS5X360E: FXAA 3.11 (NVIDIA, third_party/fxaa), the highest quality preset,
+// on the guest output after SMAA and before the scaling and sharpening
+// effects. Uses the SMAA passes' descriptor set layout: binding 0 the source,
+// 3 a linear clamping sampler. Push constant: 1 / width, 1 / height, width,
+// height.
+
+[[vk::push_constant]] cbuffer XeFxaaConstants {
+  float4 xe_fxaa_rt_metrics;
+};
+
+[[vk::binding(0, 0)]] Texture2D<float4> xe_fxaa_source;
+[[vk::binding(3, 0)]] SamplerState xe_fxaa_linear_sampler;
+
+#define FXAA_PC 1
+#define FXAA_HLSL_5 1
+#define FXAA_QUALITY__PRESET 39
+// The source has no luma in alpha; green is close enough.
+#define FXAA_GREEN_AS_LUMA 1
+#include "../../../../third_party/fxaa/FXAA3_11.h"
+
+struct XeFxaaPixelInput {
+  float4 position : SV_Position;
+};
+
+[shader("fragment")]
+float4 main(XeFxaaPixelInput input) : SV_Target0 {
+  float2 size_inv = xe_fxaa_rt_metrics.xy;
+  FxaaTex fxaa_texture;
+  fxaa_texture.smpl = xe_fxaa_linear_sampler;
+  fxaa_texture.tex = xe_fxaa_source;
+  float2 texcoord = input.position.xy * size_inv;
+  float2 pixel = floor(input.position.xy);
+  return float4(
+      FxaaPixelShader(
+          texcoord, (pixel.xyxy + float2(0.0, 1.0).xxyy) * size_inv.xyxy,
+          fxaa_texture, fxaa_texture, fxaa_texture, size_inv,
+          float2(-0.5, 0.5).xxyy * size_inv.xyxy,
+          float2(-2.0, 2.0).xxyy * size_inv.xyxy,
+          float2(8.0, -4.0).xxyy * size_inv.xyxy,
+          // Subpixel 1.0, edge thresholds as Xenia's FXAA (extreme).
+          1.0, 0.063, 0.0312, 8.0, 0.125, 0.05,
+          float4(1.0, -1.0, 0.25, -0.25))
+          .rgb,
+      1.0);
+}
