+inline std::atomic<uint32_t> frame_trace_wide_resolves[8];
+inline std::atomic<uint32_t> frame_trace_wide_resolve_count{0};
+inline bool FrameTraceWideResolve(uint32_t start, uint32_t length) {
+  const uint32_t count = std::min<uint32_t>(
+      frame_trace_wide_resolve_count.load(std::memory_order_relaxed), 8);
+  for (uint32_t i = 0; i < count; ++i) {
+    const uint32_t base =
+        frame_trace_wide_resolves[i].load(std::memory_order_relaxed);
+    // The target and the two 128 KiB objects after it (NFS The Run keeps
+    // CPU-written data and a texture there).
+    if (start < base + 0x60000 && base < start + length) {
+      return true;
+    }
+  }
+  return FrameTraceRingInput(start, length);
+}
