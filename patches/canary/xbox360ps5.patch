+  if (!accounts_.count(xuid)) return false;
+  const auto root = kernel_state_->emulator()->content_root().lexically_normal();
+  const auto source = GetProfileContentPath(xuid).lexically_normal();
+  const auto backup = root / "removed-profiles";
+  std::error_code error;
+  if (source.parent_path() != root || std::filesystem::is_symlink(source, error) ||
+      !std::filesystem::is_directory(source, error)) return false;
+  error.clear();
+  if (std::filesystem::is_symlink(backup, error)) return false;
+  error.clear();
+  std::filesystem::create_directories(backup, error);
+  if (error) return false;
+  auto destination = backup / fmt::format("{:016X}", xuid);
+  for (unsigned n = 1; std::filesystem::exists(destination, error) && !error; ++n) {
+    if (n > 1024) return false;
+    destination = backup / fmt::format("{:016X}-{}", xuid, n);
+  }
+  if (error || destination.parent_path() != backup) return false;
+  const uint8_t slot = GetUserIndexAssignedToProfile(xuid);
+  if (slot < XUserMaxUserCount) Logout(slot, false);
+  else DismountProfile(xuid);
+  std::filesystem::rename(source, destination, error);
+  if (error) {
+    if (slot < XUserMaxUserCount) Login(xuid, slot, false);
+    XELOGE("Cannot archive profile: {}", error.message());
+    return false;
+  }
+  accounts_.erase(xuid);
+  XELOGW("Profile removed; recoverable data retained in {}", destination.string());
+  return true;
+}
