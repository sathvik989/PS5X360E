+#if XE_PLATFORM_PS5
+// PS5X360E (from PS5X360 0.5.9): XamShowKeyboardUI with the controller
+// keyboard. Guest strings are read now (never deferred into the caller's
+// stack), every guest page is checked before use, and the dialog is waited for
+// the way Xenia Edge waits for its other dialogs (the fiber parks).
+X_RESULT ShowControllerKeyboard(uint32_t user_index,
+                                lpu16string_t default_text,
+                                lpu16string_t title,
+                                lpu16string_t description,
+                                lpu16string_t buffer, uint32_t buffer_length,
+                                pointer_t<XAM_OVERLAPPED> overlapped) {
+  namespace keyboard = xe::ui::controller_keyboard;
+  auto* state = kernel_state();
+  const auto* emulator = state->emulator();
+  auto* drawer = emulator->imgui_drawer();
+  auto* window = emulator->display_window();
+  const auto valid_range = [state](uint32_t address, uint64_t bytes,
+                                   uint32_t access) {
+    return keyboard::ValidRange(address, bytes, [state, access](uint32_t at) {
+      auto* heap = state->memory()->LookupHeap(at);
+      HeapAllocationInfo info{};
+      return heap && heap->QueryRegionInfo(at, &info) &&
+             (info.state & kMemoryAllocationCommit) &&
+             (info.protect & access) == access;
+    });
+  };
+  constexpr uint32_t kMaximumUnits = 65536;
+  if ((buffer.guest_address() & 1) || buffer_length > kMaximumUnits ||
+      !valid_range(buffer.guest_address(), uint64_t(buffer_length) * 2,
+                   kMemoryProtectWrite) ||
+      (overlapped &&
+       ((overlapped.guest_address() & 3) ||
+        !valid_range(overlapped.guest_address(), sizeof(XAM_OVERLAPPED),
+                     kMemoryProtectRead | kMemoryProtectWrite)))) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+  const auto read_bounded = [&](uint32_t address, size_t limit,
+                                std::u16string& text) {
+    return keyboard::ReadText(
+        address, limit,
+        [&](uint32_t at, char16_t& c) {
+          if (!valid_range(at, 2, kMemoryProtectRead)) return false;
+          const auto* bytes =
+              state->memory()->TranslateVirtual<const uint8_t*>(at);
+          c = char16_t(uint16_t(bytes[0]) << 8 | bytes[1]);
+          return true;
+        },
+        text);
+  };
+  std::u16string initial_text, guest_title, guest_description;
+  if (!read_bounded(default_text.guest_address(), kMaximumUnits,
+                    initial_text) ||
+      !read_bounded(title.guest_address(), 4096, guest_title) ||
+      !read_bounded(description.guest_address(), 4096, guest_description)) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+  if (state->xam_state()->IsUIActive() ||
+      !keyboard::Bridge().Begin(user_index)) {
+    return X_ERROR_ACCESS_DENIED;
+  }
+  state->xam_state()->is_xam_dialog_present_.store(true);
+  const auto title_text =
+      xe::to_utf8(keyboard::Fit(guest_title, guest_title.size() + 1));
+  const auto description_text = xe::to_utf8(
+      keyboard::Fit(guest_description, guest_description.size() + 1));
+  void* output = buffer;
+  const uint32_t capacity = buffer_length;
+  const uint32_t output_address = buffer.guest_address();
+  auto run = [state, window, drawer, title_text, description_text,
+              initial_text, output, output_address, valid_range, capacity,
+              asynchronous = bool(overlapped)](uint32_t& extended_error,
+                                               uint32_t& length) -> X_RESULT {
+    extended_error = X_ERROR_CANCELLED;
+    length = 0;
+    auto completion = std::make_shared<xe::ui::ControllerKeyboardCompletion>();
+    xe::threading::Fence fence;
+    const bool dispatched = window->app_context().CallInUIThreadSynchronous([&] {
+      auto* dialog = new xe::ui::ControllerKeyboardDialog(
+          drawer, title_text, description_text, initial_text, capacity,
+          completion);
+      dialog->Then(&fence);
+    });
+    if (dispatched) {
+      GuestScheduler::WaitOnFence(fence);
+    } else {
+      keyboard::Bridge().End();
+    }
+    state->xam_state()->is_xam_dialog_present_.store(false);
+    if (!dispatched) {
+      extended_error = X_ERROR_FUNCTION_FAILED;
+      return X_ERROR_FUNCTION_FAILED;
+    }
+    if (completion->result != keyboard::Result::accepted) {
+      // Cancelled: the guest buffer is left as it was.
+      return asynchronous ? X_ERROR_SUCCESS : X_ERROR_CANCELLED;
+    }
+    // The game may have freed its output while the keyboard was open.
+    if (!valid_range(output_address, uint64_t(capacity) * 2,
+                     kMemoryProtectWrite)) {
+      extended_error = X_ERROR_INVALID_PARAMETER;
+      return X_ERROR_INVALID_PARAMETER;
+    }
+    keyboard::WriteBE(output, capacity, completion->text);
+    extended_error = X_ERROR_SUCCESS;
+    return X_ERROR_SUCCESS;
+  };
+  auto pre = [state] {
+    state->BroadcastNotification(kXNotificationSystemUI, true);
+  };
+  auto post = [state] {
+    xe::threading::Sleep(kUIDelayMillis);
+    state->BroadcastNotification(kXNotificationSystemUI, false);
+  };
+  if (overlapped) {
+    state->CompleteOverlappedDeferredEx(run, overlapped, pre, post);
+    return X_ERROR_IO_PENDING;
+  }
+  pre();
+  uint32_t extended_error = 0, length = 0;
+  const auto result = run(extended_error, length);
+  post();
+  return result;
+}
+#endif  // XE_PLATFORM_PS5
