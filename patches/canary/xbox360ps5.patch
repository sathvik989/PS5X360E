diff --git a/src/xenia/ui/controller_keyboard.h b/src/xenia/ui/controller_keyboard.h
new file mode 100644
index 000000000..24f20af58
--- /dev/null
+++ b/src/xenia/ui/controller_keyboard.h
@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: MIT
+#ifndef XENIA_UI_CONTROLLER_KEYBOARD_H_
+#define XENIA_UI_CONTROLLER_KEYBOARD_H_
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+namespace xe::ui::controller_keyboard {
+// Query must verify committed guest pages and the requested access bits.
+template<class Query> bool ValidRange(uint32_t address, uint64_t bytes, Query query) {
+  if (!address || !bytes || uint64_t(address) + bytes > 0x100000000ull) return false;
+  const uint64_t end = uint64_t(address) + bytes;
+  for (uint64_t page = address; page < end; page = (page & ~uint64_t(4095)) + 4096)
+    if (!query(uint32_t(page))) return false;
+  return true;
+}
+template<class Read> bool ReadText(uint32_t address, size_t limit,
+                                 Read read, std::u16string& text) {
+  text.clear();
+  if (!address) return true;
+  if (address & 1) return false;
+  for (size_t i = 0; i < limit; ++i) {
+    const uint64_t at = uint64_t(address) + i * 2;
+    if (at + 2 > 0x100000000ull) return false;
+    char16_t c;
+    if (!read(uint32_t(at), c)) return false;
+    if (!c) return true;
+    text += c;
+  }
+  return false;  // Unterminated input is not a license to scan all guest memory.
+}
+inline bool High(char16_t c) { return c >= 0xd800 && c <= 0xdbff; }
+inline bool Low(char16_t c) { return c >= 0xdc00 && c <= 0xdfff; }
+// Capacity is in UTF-16 code units INCLUDING the terminating NUL.
+inline std::u16string Fit(std::u16string_view text, size_t capacity) {
+  std::u16string out;
+  const size_t limit = capacity ? capacity - 1 : 0;
+  for (size_t i = 0; i < text.size() && text[i]; ++i) {
+    char16_t c = text[i];
+    if (High(c) && i + 1 < text.size() && Low(text[i + 1])) {
+      if (out.size() + 2 > limit) break;
+      out += c; out += text[++i];
+    } else {
+      if (out.size() == limit) break;
+      out += (High(c) || Low(c)) ? char16_t(0xfffd) : c;
+    }
+  }
+  return out;
+}
+inline void WriteBE(void* buffer, size_t capacity, std::u16string_view text) {
+  auto* bytes = static_cast<uint8_t*>(buffer);
+  const auto fitted = Fit(text, capacity);
+  for (size_t i = 0; i < capacity; ++i) {
+    const uint16_t c = i < fitted.size() ? fitted[i] : 0;
+    bytes[2 * i] = uint8_t(c >> 8); bytes[2 * i + 1] = uint8_t(c);
+  }
+}
+
+enum class Result { pending, accepted, cancelled };
+class Editor {
+ public:
+  Editor(std::u16string text, size_t capacity)
+      : capacity_(capacity), text_(Fit(text, capacity)), cursor_(text_.size()) {}
+  const std::u16string& text() const { return text_; }
+  size_t cursor() const { return cursor_; }
+  Result result() const { return result_; }
+  int selected() const { return selected_; }
+  bool upper() const { return upper_; }
+  bool symbols() const { return symbols_; }
+  char16_t Symbol(int key) const {
+    constexpr std::u16string_view letters = u"1234567890qwertyuiopasdfghjkl;zxcvbnm,.'";
+    constexpr std::u16string_view symbols = u"!@#$%^&*()[]{}<>/\\|?+-=_:;\"'`~.,0123456789";
+    char16_t c = (symbols_ ? symbols : letters)[size_t(key)];
+    if (!symbols_ && upper_ && c >= u'a' && c <= u'z') c -= 32;
+    return c;
+  }
+  bool Insert(std::u16string_view value) {
+    if (result_ != Result::pending) return false;
+    const auto valid = Fit(value, value.size() + 1);
+    if (valid.size() + text_.size() >= capacity_) return false;
+    text_.insert(cursor_, valid); cursor_ += valid.size(); return true;
+  }
+  void Left() {
+    if (!cursor_) return;
+    --cursor_;
+    if (cursor_ && Low(text_[cursor_]) && High(text_[cursor_ - 1])) --cursor_;
+  }
+  void Right() {
+    if (cursor_ == text_.size()) return;
+    if (High(text_[cursor_]) && cursor_ + 1 < text_.size() && Low(text_[cursor_ + 1])) ++cursor_;
+    ++cursor_;
+  }
+  void Backspace() {
+    const size_t old = cursor_; Left(); text_.erase(cursor_, old - cursor_);
+  }
+  void Select(int key) { selected_ = std::clamp(key, 0, 49); }
+  void Activate() {
+    if (result_ != Result::pending) return;
+    if (selected_ < 40) { const char16_t c = Symbol(selected_); Insert({&c, 1}); return; }
+    switch (selected_) {
+      case 40: Insert(u" "); break;
+      case 41: Backspace(); break;
+      case 42: upper_ = !upper_; break;
+      case 43: symbols_ = !symbols_; break;
+      case 44: Left(); break;
+      case 45: Right(); break;
+      case 46: cursor_ = 0; break;
+      case 47: cursor_ = text_.size(); break;
+      case 48: Finish(Result::cancelled); break;
+      case 49: Finish(Result::accepted); break;
+    }
+  }
+  void Finish(Result result) { if (result_ == Result::pending) result_ = result; }
+  void Press(uint32_t pressed) {
+    if (result_ != Result::pending) return;
+    // Cancel wins if multiple actions occur in the same sample.
+    if (pressed & 0x2000) { Finish(Result::cancelled); return; }
+    if (pressed & 0x08) { Finish(Result::accepted); return; }
+    int row = selected_ / 10, col = selected_ % 10;
+    if (pressed & 0x10) row = (row + 4) % 5;
+    if (pressed & 0x40) row = (row + 1) % 5;
+    if (pressed & 0x80) col = (col + 9) % 10;
+    if (pressed & 0x20) col = (col + 1) % 10;
+    selected_ = row * 10 + col;
+    if (pressed & 0x8000) Backspace();
+    if (pressed & 0x1000) upper_ = !upper_;
+    if (pressed & 0x400) Left();
+    if (pressed & 0x800) Right();
+    if (pressed & 0x4000) Activate();
+  }
+ private:
+  size_t capacity_;
+  std::u16string text_;
+  size_t cursor_;
+  int selected_ = 0;
+  bool upper_ = false, symbols_ = false;
+  Result result_ = Result::pending;
+};
+
+// Shared by the native polling thread, guest input drivers and UI thread.
+// Feed physical samples BEFORE guide filtering. Never logs text or pad data.
+class PadBridge {
+ public:
+  void SetAvailable(bool available) {
+    std::lock_guard lock(mutex_); available_ = available;
+    if (!available && active_) cancel_ = true;
+  }
+  bool available() const { std::lock_guard lock(mutex_); return available_; }
+  bool Begin(uint32_t user) {
+    std::lock_guard lock(mutex_);
+    if (!available_ || active_ || user >= 4) return false;
+    active_ = true; cancel_ = false; user_ = user; drain_.fill(true);
+    armed_ = false; previous_ = 0; pending_ = 0; repeat_at_ = 0;
+    return true;
+  }
+  void End() { std::lock_guard lock(mutex_); active_ = false; pending_ = 0; }
+  bool active() const { std::lock_guard lock(mutex_); return active_; }
+  void Cancel() { std::lock_guard lock(mutex_); if (active_) cancel_ = true; }
+  bool cancelled() const { std::lock_guard lock(mutex_); return cancel_; }
+  bool Suppressed(uint32_t user) const {
+    std::lock_guard lock(mutex_);
+    return active_ || (user < 4 && drain_[user]);
+  }
+  template<class Sample> void Publish(uint32_t user, const Sample& pad, uint64_t now_ms) {
+    std::lock_guard lock(mutex_);
+    if (user >= 4) return;
+    uint32_t buttons = pad.connected ? pad.buttons : 0;
+    if (pad.connected) {
+      if (pad.lx < 64) buttons |= 0x80;
+      if (pad.lx > 192) buttons |= 0x20;
+      if (pad.ly < 64) buttons |= 0x10;
+      if (pad.ly > 192) buttons |= 0x40;
+    }
+    const auto centered = [](uint8_t axis) { return axis >= 96 && axis <= 160; };
+    const bool neutral = !pad.connected || (!pad.buttons && pad.l2 < 16 && pad.r2 < 16 &&
+        centered(pad.lx) && centered(pad.ly) && centered(pad.rx) && centered(pad.ry));
+    if (!active_ && neutral) drain_[user] = false;
+    if (!active_ || user != user_) return;
+    if (!pad.connected) {
+      armed_ = false; previous_ = 0; pending_ = 0; return;
+    }
+    // Require release on opening: a game's accept press cannot type/close this UI.
+    if (!armed_) { if (neutral) armed_ = true; previous_ = buttons; return; }
+    const uint32_t pressed = buttons & ~previous_;
+    pending_ |= pressed;
+    constexpr uint32_t directions = 0xf0;
+    if (pressed & directions) repeat_at_ = now_ms + 400;
+    else if ((buttons & directions) && now_ms >= repeat_at_) {
+      pending_ |= buttons & directions; repeat_at_ = now_ms + 110;
+    }
+    previous_ = buttons;
+  }
+  uint32_t TakePressed() { std::lock_guard lock(mutex_); const auto p = pending_; pending_ = 0; return p; }
+ private:
+  mutable std::mutex mutex_;
+  bool available_ = false, active_ = false, armed_ = false, cancel_ = false;
+  uint32_t user_ = 0, previous_ = 0, pending_ = 0;
+  uint64_t repeat_at_ = 0;
+  std::array<bool, 4> drain_{};
+};
+inline PadBridge& Bridge() { static PadBridge bridge; return bridge; }
+inline bool Active() { return Bridge().active(); }
+inline bool Suppressed(uint32_t user = 0) { return Bridge().Suppressed(user); }
+inline void SetAvailable(bool available) { Bridge().SetAvailable(available); }
+inline void Cancel() { Bridge().Cancel(); }
+template<class Sample> void SubmitPad(uint32_t user, const Sample& pad, uint64_t now_ms) {
+  Bridge().Publish(user, pad, now_ms);
+}
+}  // namespace xe::ui::controller_keyboard
+#endif
