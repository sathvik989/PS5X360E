+std::optional<GdfxFileLocation> FindXboxOriginalXbe(
+    const std::filesystem::path& path) {
+  auto file = xe::filesystem::FileHandle::OpenExisting(
+      path, xe::filesystem::FileAccess::kGenericRead);
+  std::error_code size_error;
+  const uint64_t size = std::filesystem::file_size(path, size_error);
+  if (!file || size_error) {
+    return std::nullopt;
+  }
+  auto read = [&file, size](size_t offset, void* buffer, size_t length) {
+    size_t bytes_read = 0;
+    return offset <= size && size - offset >= length &&
+           file->Read(offset, buffer, length, &bytes_read) &&
+           bytes_read == length;
+  };
