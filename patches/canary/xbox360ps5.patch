+void VulkanPipelineCache::MaybeSavePipelineCache() {
+  // PS5X360E: the cache was only saved when the title shut down cleanly, which
+  // closing the app on the PS5 never does, so every launch compiled every
+  // pipeline again. Saved during play instead: 10 s after new pipelines
+  // appeared, then at most once every 60 s, written on a thread of its own.
+  if (vk_pipeline_cache_ == VK_NULL_HANDLE || vk_pipeline_cache_path_.empty() ||
+      !pipelines_created_since_save_.load(std::memory_order_relaxed) ||
+      pipeline_cache_save_running_.load(std::memory_order_acquire)) {
+    return;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (pipeline_cache_first_unsaved_ == std::chrono::steady_clock::time_point{}) {
+    pipeline_cache_first_unsaved_ = now;
+  }
+  if (now - pipeline_cache_first_unsaved_ < std::chrono::seconds(10) ||
+      now - pipeline_cache_last_save_ < std::chrono::seconds(60)) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device =
+      command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  size_t cache_size = 0;
+  // Why a save could not be made, once each, as the shader cache was never
+  // found written on the PS5 (every launch compiled every pipeline again).
+  static bool reported_query = false, reported_data = false;
+  const VkResult size_result =
+      dfn.vkGetPipelineCacheData(device, vk_pipeline_cache_, &cache_size,
+                                 nullptr);
+  if (size_result != VK_SUCCESS || !cache_size ||
+      !xbox360ps5::ValidPipelineCacheSize(int64_t(cache_size))) {
+    if (!reported_query) {
+      reported_query = true;
+      XELOGW(
+          "Shader cache: not saved: the driver gave result {} and size {} "
+          "bytes for {} new pipelines",
+          int(size_result), cache_size,
+          pipelines_created_since_save_.load(std::memory_order_relaxed));
+    }
+    pipeline_cache_last_save_ = now;
+    return;
+  }
+  auto data = std::make_shared<std::vector<uint8_t>>(cache_size);
+  const VkResult data_result = dfn.vkGetPipelineCacheData(
+      device, vk_pipeline_cache_, &cache_size, data->data());
+  if (data_result != VK_SUCCESS) {
+    if (!reported_data) {
+      reported_data = true;
+      XELOGW("Shader cache: not saved: reading {} bytes gave result {}",
+             cache_size, int(data_result));
+    }
+    pipeline_cache_last_save_ = now;
+    return;
+  }
+  data->resize(cache_size);
+  const uint64_t pipelines =
+      pipelines_created_since_save_.exchange(0, std::memory_order_relaxed);
+  pipeline_cache_first_unsaved_ = {};
+  pipeline_cache_last_save_ = now;
+  pipeline_cache_save_running_.store(true, std::memory_order_release);
+  // And how far the guest shader and pipeline storage files have grown, as
+  // stored pipelines were never found at launch.
+  std::filesystem::path shader_storage_path, pipeline_storage_path;
+  if (storage_writer_.is_active()) {
+    shader_storage_path = GetShaderStorageFilePath(
+        storage_writer_.cache_root(), storage_writer_.title_id());
+    pipeline_storage_path =
+        GetShaderStorageShareableRoot(storage_writer_.cache_root()) /
+        fmt::format("{:08X}.{}.vk.xpso", storage_writer_.title_id(),
+                    render_target_cache_.GetPath() ==
+                            RenderTargetCache::Path::kPixelShaderInterlock
+                        ? "fsi"
+                        : "fbo");
+  }
+  std::thread([this, data, pipelines, path = vk_pipeline_cache_path_,
+               shader_storage_path, pipeline_storage_path]() {
+    const bool written =
+        xbox360ps5::WriteCacheAtomically(path, data->data(), data->size());
+    std::error_code error;
+    const auto shader_bytes =
+        shader_storage_path.empty()
+            ? 0
+            : std::filesystem::file_size(shader_storage_path, error);
+    const auto pipeline_bytes =
+        pipeline_storage_path.empty()
+            ? 0
+            : std::filesystem::file_size(pipeline_storage_path, error);
+    XELOGW(
+        "Shader cache: saved {} KiB ({} new pipelines) to {}{}; storage {} "
+        "KiB of shaders, {} KiB of pipelines{}",
+        data->size() >> 10, pipelines, path.string(),
+        written ? "" : " - failed", uint64_t(shader_bytes) >> 10,
+        uint64_t(pipeline_bytes) >> 10,
+        shader_storage_path.empty() ? " (storage inactive)" : "");
+    pipeline_cache_save_running_.store(false, std::memory_order_release);
+  }).detach();
+}
