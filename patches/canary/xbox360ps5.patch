+// Xbox360PS5: see KeepRecentLines in logging.h.
+namespace {
+constexpr size_t kRecentBytes = 1024 * 1024;
+constexpr size_t kRecentLineLimit = 300;
+std::atomic<bool> keep_recent_lines_{false};
+std::mutex recent_mutex_;
+std::unique_ptr<char[]> recent_lines_;
+size_t recent_end_ = 0;
+bool recent_wrapped_ = false;
+
+bool GoesToLog(LogLevel log_level, uint32_t log_mask) {
+  return static_cast<int32_t>(log_level) <= cvars::log_level &&
+         (log_mask & cvars::log_mask) == 0;
+}
+
+bool IsKept(LogLevel log_level, uint32_t log_mask) {
+  return keep_recent_lines_.load(std::memory_order_relaxed) &&
+         log_level <= LogLevel::Debug &&
+         !(log_mask & (LogSrc::Apu | LogSrc::Cpu | LogSrc::Gpu));
+}
+
+void RememberLine(const char prefix_char, const char* text, size_t size) {
+  char head[16];
+  const int head_size =
+      std::snprintf(head, sizeof(head), "%c> %08X ", prefix_char,
+                    xe::threading::current_thread_id());
+  size = std::min(size, kRecentLineLimit);
+  std::lock_guard<std::mutex> lock(recent_mutex_);
+  if (!recent_lines_) {
+    return;
+  }
+  const auto put = [](char value) {
+    recent_lines_[recent_end_] = value;
+    if (++recent_end_ == kRecentBytes) {
+      recent_end_ = 0;
+      recent_wrapped_ = true;
+    }
+  };
+  for (int n = 0; n < head_size; ++n) put(head[n]);
+  for (size_t n = 0; n < size; ++n) put(text[n] == '\n' ? ' ' : text[n]);
+  put('\n');
+}
+}  // namespace
+
+void logging::KeepRecentLines(bool keep) {
+  std::lock_guard<std::mutex> lock(recent_mutex_);
+  if (keep) {
+    if (!recent_lines_) {
+      recent_lines_ = std::make_unique<char[]>(kRecentBytes);
+    }
+    recent_end_ = 0;
+    recent_wrapped_ = false;
+  }
+  keep_recent_lines_ = keep;
+}
+
+void logging::WriteRecentLines() {
+  std::string lines;
+  bool cut = false;
+  {
+    std::lock_guard<std::mutex> lock(recent_mutex_);
+    if (!recent_lines_) {
+      return;
+    }
+    cut = recent_wrapped_;
+    if (recent_wrapped_) {
+      lines.assign(recent_lines_.get() + recent_end_,
+                   kRecentBytes - recent_end_);
+    }
+    lines.append(recent_lines_.get(), recent_end_);
+    recent_end_ = 0;
+    recent_wrapped_ = false;
+  }
+  if (!logger_) {
+    return;
+  }
+  size_t at = 0;
+  if (cut) {
+    // The oldest line lost its beginning when the memory came round.
+    at = lines.find('\n');
+    at = at == std::string::npos ? lines.size() : at + 1;
+  }
+  const uint32_t writer = xe::threading::current_thread_id();
+  while (at < lines.size()) {
+    size_t end = lines.find('\n', at);
+    if (end == std::string::npos) {
+      end = lines.size();
+    }
+    if (end > at) {
+      logger_->AppendLine(writer, 'r', lines.data() + at, end - at);
+    }
+    at = end + 1;
+  }
+}
+
+bool logging::ShouldLog(LogLevel log_level, uint32_t log_mask) {
+  return GoesToLog(log_level, log_mask) || IsKept(log_level, log_mask);
+}
