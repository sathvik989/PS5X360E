+  PushBufferMemoryBarrier(host_buffer, VkDeviceSize(address),
+                          VkDeviceSize(length), VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          read_stages | VK_PIPELINE_STAGE_HOST_BIT,
+                          VK_ACCESS_TRANSFER_WRITE_BIT,
+                          read_access | VK_ACCESS_TRANSFER_WRITE_BIT |
+                              VK_ACCESS_HOST_READ_BIT);
