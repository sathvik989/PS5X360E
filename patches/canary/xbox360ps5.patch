+}
+
+void VulkanCommandProcessor::MarkGpuOutputHostStale(uint32_t base_bytes,
+                                                    uint32_t size_bytes) {
+  if (!cvars::host_buffer_resolve_sync || !size_bytes ||
+      base_bytes >= SharedMemory::kBufferSize ||
+      shared_memory_->host_buffer() == VK_NULL_HANDLE) {
+    return;
+  }
+  size_bytes = std::min(size_bytes, SharedMemory::kBufferSize - base_bytes);
+  const uint32_t first_page = base_bytes >> 12;
+  const uint32_t last_page = (base_bytes + size_bytes - 1) >> 12;
+  for (uint32_t page = first_page; page <= last_page; ++page) {
+    host_stale_gpu_pages_[page >> 6] |= uint64_t(1) << (page & 63);
+  }
+  host_stale_page_min_ = std::min(host_stale_page_min_, first_page);
+  host_stale_page_max_ = std::max(host_stale_page_max_, last_page);
+}
+
+void VulkanCommandProcessor::EnsureGpuOutputInHostBuffer(uint32_t base_bytes,
+                                                         uint32_t size_bytes) {
+  if (!size_bytes || host_stale_page_min_ > host_stale_page_max_) {
+    return;
+  }
+  base_bytes &= 0x1FFFFFFF;
+  if (base_bytes >= SharedMemory::kBufferSize) {
+    return;
+  }
+  size_bytes = std::min(size_bytes, SharedMemory::kBufferSize - base_bytes);
+  const uint32_t first_page = std::max(base_bytes >> 12, host_stale_page_min_);
+  const uint32_t last_page =
+      std::min((base_bytes + size_bytes - 1) >> 12, host_stale_page_max_);
+  if (first_page > last_page) {
+    return;
+  }
+  host_stale_copy_regions_.clear();
+  uint32_t copy_start = UINT32_MAX, copy_end = 0;
+  for (uint32_t page = first_page; page <= last_page; ++page) {
+    uint64_t& block = host_stale_gpu_pages_[page >> 6];
+    const uint64_t bit = uint64_t(1) << (page & 63);
+    if (!(block & bit)) {
+      continue;
+    }
+    block &= ~bit;
+    // Only while the device buffer still holds the newest data there: a CPU
+    // write since, or memory export output in the host buffer, clears it.
+    if (!shared_memory_->IsGpuWrittenAddress(page << 12)) {
+      continue;
+    }
+    const uint32_t offset = page << 12;
+    if (!host_stale_copy_regions_.empty()) {
+      VkBufferCopy& last = host_stale_copy_regions_.back();
+      if (last.srcOffset + last.size == offset) {
+        last.size += 4096;
+        copy_end = offset + 4096;
+        continue;
+      }
+    }
+    VkBufferCopy& region = host_stale_copy_regions_.emplace_back();
+    region.srcOffset = offset;
+    region.dstOffset = offset;
+    region.size = 4096;
+    copy_start = std::min(copy_start, offset);
+    copy_end = offset + 4096;
+  }
+  if (host_stale_copy_regions_.empty()) {
+    return;
+  }
+  VkBuffer host_buffer = shared_memory_->host_buffer();
+  VkBuffer device_buffer = shared_memory_->buffer();
+  if (host_buffer == VK_NULL_HANDLE) {
+    return;
+  }
+  const VkDeviceSize range_base = copy_start;
+  const VkDeviceSize range_size = copy_end - copy_start;
+  const VkPipelineStageFlags read_stages =
+      VK_PIPELINE_STAGE_VERTEX_INPUT_BIT | guest_shader_pipeline_stages_ |
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+  const VkAccessFlags read_access = VK_ACCESS_INDEX_READ_BIT |
+                                    VK_ACCESS_SHADER_READ_BIT |
+                                    VK_ACCESS_TRANSFER_READ_BIT;
+  // Resolve output in the device buffer (written by transfer or compute)
+  // before the transfer read, and earlier host buffer accesses before the
+  // transfer write into it.
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  PushBufferMemoryBarrier(
+      device_buffer, range_base, range_size,
+      guest_shader_pipeline_stages_ | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT |
+          VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_ACCESS_TRANSFER_READ_BIT);
+  PushBufferMemoryBarrier(
+      host_buffer, range_base, range_size, read_stages,
+      VK_PIPELINE_STAGE_TRANSFER_BIT,
+      read_access | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_ACCESS_TRANSFER_WRITE_BIT);
+  SubmitBarriers(true);
+  deferred_command_buffer_.CmdVkCopyBuffer(
+      device_buffer, host_buffer, uint32_t(host_stale_copy_regions_.size()),
+      host_stale_copy_regions_.data());
+  PushBufferMemoryBarrier(host_buffer, range_base, range_size,
+                          VK_PIPELINE_STAGE_TRANSFER_BIT, read_stages,
+                          VK_ACCESS_TRANSFER_WRITE_BIT, read_access);
+  if (FrameTraceLine()) {
+    XELOGW("FT {} HOSTSYNC {:08X} {} in {} runs",
+           frame_trace_frame.load(std::memory_order_relaxed), copy_start,
+           copy_end - copy_start, host_stale_copy_regions_.size());
+  }
+}
