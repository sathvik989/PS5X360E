+#if !XE_PLATFORM_PS5
+// Host-only ABI regression: runs an actual PowerPC completion routine, rather
+// than substituting a host callback. No game code or camera recording is used.
+bool CheckVirtualCameraAbi(KernelState* kernel) {
+  auto* memory = kernel->memory();
+  const uint32_t storage = memory->SystemHeapAlloc(0xB0000);
+  if (!storage) return false;
+  auto* words = memory->TranslateVirtual<xe::be<uint32_t>*>(storage);
+  std::memset(words, 0, 0xB0000);
+  bool ok = true;
+  {
+    CameraDevice device(kernel);
+    ok &= device.Request(0) == X_STATUS_INVALID_PARAMETER;
+    ok &= device.Request(0xFFFFFFFC) == X_STATUS_INVALID_PARAMETER;
+    words[0] = 0;
+    ok &= device.Request(storage) == X_STATUS_SUCCESS && words[1] == 4;
+    words[0] = 13;
+    ok &= device.Request(storage) == X_STATUS_SUCCESS;
+    const auto* version = memory->TranslateVirtual<X_PSCAM_VERSION_REQUEST*>(storage);
+    ok &= version->major == 5 && version->minor == 1;
+    words[0] = 24; words[2] = storage + 0x2000; words[3] = 8192;
+    ok &= device.Request(storage) == X_STATUS_SUCCESS;
+    auto* table = memory->TranslateVirtual<xe::be<uint16_t>*>(storage+0x2000);
+    ok &= table[625] == 2500 && table[2047] == 0;
+    words[2] = 0xFFFFFFF0;
+    ok &= device.Request(storage) == X_STATUS_INVALID_PARAMETER;
+
+    std::memset(words, 0, 0x1000);
+    const uint32_t results = storage + 0x80, code = 0x81010000;
+    auto* code_heap = memory->LookupHeap(code);
+    if (!code_heap || !code_heap->AllocFixed(code, 4096, 4096,
+        kMemoryAllocationReserve | kMemoryAllocationCommit,
+        kMemoryProtectRead | kMemoryProtectWrite)) return false;
+    auto* instructions = memory->TranslateVirtual<xe::be<uint32_t>*>(code);
+    instructions[0] = 0x3CC00000 | (results >> 16); // lis r6,hi
+    instructions[1] = 0x60C60000 | (results & 0xFFFF); // ori r6,r6,lo
+    instructions[2] = 0x90860000; // stw r4,0(r6): status
+    instructions[3] = 0x90A60004; // stw r5,4(r6): byte count
+    instructions[4] = 0x4E800020; // blr
+    auto module = std::make_unique<cpu::RawModule>(kernel->processor());
+    module->set_name("virtual-camera-abi-check");
+    module->SetAddressRange(code, 4096);
+    ok &= kernel->processor()->AddModule(std::move(module));
+    words[0] = 5; words[5] = code; words[6] = 4;
+    words[7] = storage + 0x10000; words[8] = kDepthFrameBytes;
+    words[10] = storage + 0x88;
+    const auto before = xbox360ps5::motion::guest_completed_requests.load();
+    ok &= device.Request(storage) == X_STATUS_PENDING;
+    const auto deadline = std::chrono::steady_clock::now()+std::chrono::seconds(5);
+    while (xbox360ps5::motion::guest_completed_requests.load()==before &&
+           std::chrono::steady_clock::now()<deadline)
+      xe::threading::Sleep(std::chrono::milliseconds(5));
+    auto* result = memory->TranslateVirtual<xe::be<uint32_t>*>(results);
+    XELOGW("Camera ABI check: completed {}->{} status {:08X}, bytes {}, counter {}, earlier checks {}",
+      before, xbox360ps5::motion::guest_completed_requests.load(), uint32_t(result[0]), uint32_t(result[1]), uint32_t(result[2]), ok);
+    ok &= xbox360ps5::motion::guest_completed_requests.load()>before;
+    ok &= result[0] == X_STATUS_SUCCESS && result[1] == kDepthFrameBytes && result[2] != 0;
+    words[0] = 2; words[5] = 0;
+    ok &= device.Request(storage) == X_STATUS_SUCCESS;
+    words[0] = 0;
+    ok &= device.Request(storage) == X_STATUS_SUCCESS && words[1] == 4;
+  }
+  memory->SystemHeapFree(storage);
+  return ok;
+}
+#endif
