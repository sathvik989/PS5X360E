+void VulkanCommandProcessor::TraceRingDraw(uint32_t used_texture_mask,
+                                           const Shader& vertex_shader,
+                                           const Shader* pixel_shader) {
+  const RegisterFile& regs = *register_file_;
+  auto ram_hash = [&](uint32_t address, uint32_t length) -> uint64_t {
+    address &= 0x1FFFFFFF;
+    length = std::min(length, UINT32_C(0x20000000) - address);
+    const uint8_t* p = memory_->TranslatePhysical<const uint8_t*>(address);
+    return p ? XXH3_64bits(p, length) : 0;
+  };
+  auto is_ring_target = [&](uint32_t base) {
+    const uint32_t count = std::min<uint32_t>(
+        frame_trace_wide_resolve_count.load(std::memory_order_relaxed), 8);
+    for (uint32_t k = 0; k < count; ++k) {
+      if (frame_trace_wide_resolves[k].load(std::memory_order_relaxed) ==
+          base) {
+        return true;
+      }
+    }
+    return false;
+  };
+  // A draw sampling a ring target is one computing the next ring entry: its
+  // other textures are that entry's inputs, traced from now on.
+  bool reads_ring = false;
+  uint32_t texture_bits = used_texture_mask;
+  uint32_t texture_index;
+  while (xe::bit_scan_forward(texture_bits, &texture_index)) {
+    texture_bits = xe::clear_lowest_bit(texture_bits);
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(texture_index);
+    reads_ring |= is_ring_target((fetch.base_address << 12) & 0x1FFFFFFF);
+  }
+  bool touches = false;
+  std::string textures, vertex_buffers, exports;
+  texture_bits = used_texture_mask;
+  while (xe::bit_scan_forward(texture_bits, &texture_index)) {
+    texture_bits = xe::clear_lowest_bit(texture_bits);
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(texture_index);
+    const uint32_t base = (fetch.base_address << 12) & 0x1FFFFFFF;
+    const uint32_t mip = (fetch.mip_address << 12) & 0x1FFFFFFF;
+    const bool target = is_ring_target(base);
+    if (reads_ring && !target) {
+      FrameTraceAddRingInput(base);
+    }
+    const bool near = FrameTraceWideResolve(base, 0x20000) ||
+                      (mip && FrameTraceWideResolve(mip, 0x20000));
+    touches |= near;
+    textures += fmt::format(
+        " t{}:{:08X}/{:08X} [{:08X} {:08X} {:08X} {:08X} {:08X} {:08X}]",
+        texture_index, base, mip, fetch.dword_0, fetch.dword_1, fetch.dword_2,
+        fetch.dword_3, fetch.dword_4, fetch.dword_5);
+    if (near) {
+      textures += fmt::format(" ram {:016X} {}", ram_hash(base, 0x20000),
+                              shared_memory_->DescribeRangeState(base, 0x20000));
+    }
+  }
+  const Shader::ConstantRegisterMap& constant_map =
+      vertex_shader.constant_register_map();
+  for (uint32_t i = 0; i < xe::countof(constant_map.vertex_fetch_bitmap);
+       ++i) {
+    uint32_t bits = constant_map.vertex_fetch_bitmap[i];
+    uint32_t j;
+    while (xe::bit_scan_forward(bits, &j)) {
+      bits = xe::clear_lowest_bit(bits);
+      xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(i * 32 + j);
+      const uint32_t base = xenos::CpuToGpu(fetch.address << 2);
+      const uint32_t size = fetch.size << 2;
+      const bool near = FrameTraceWideResolve(base, std::max(size, 1u));
+      touches |= near;
+      vertex_buffers += fmt::format(" v{}:{:08X}+{:X}", i * 32 + j, base, size);
+      if (near) {
+        vertex_buffers += fmt::format(" ram {:016X}",
+                                      ram_hash(base, std::min(size, 0x80000u)));
+      }
+    }
+  }
+  for (const draw_util::MemExportRange& range : memexport_ranges_) {
+    const uint32_t base = range.base_address_dwords << 2;
+    touches |= FrameTraceWideResolve(base, std::max(range.size_bytes, 1u));
+    exports += fmt::format(" {:08X}+{:X}", base, range.size_bytes);
+  }
+  if (!touches || !FrameTraceLine()) {
+    return;
+  }
+  XELOGW(
+      "FT {} D vs {:016X} ps {:016X} rt {:08X} {:08X} mask {:08X} | tex{} | "
+      "vtx{} | mex{}",
+      frame_trace_frame.load(std::memory_order_relaxed),
+      vertex_shader.ucode_data_hash(),
+      pixel_shader ? pixel_shader->ucode_data_hash() : 0,
+      regs[XE_GPU_REG_RB_COLOR_INFO], regs[XE_GPU_REG_RB_SURFACE_INFO],
+      regs[XE_GPU_REG_RB_COLOR_MASK], textures, vertex_buffers, exports);
+}
