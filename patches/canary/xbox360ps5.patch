+    const uint32_t base = range.base_address_dwords << 2;
+    touches |= FrameTraceWideResolve(base, std::max(range.size_bytes, 1u));
+    exports += fmt::format(" {:08X}+{:X}", base, range.size_bytes);
+  }
+  if (!touches || !FrameTraceLine()) {
