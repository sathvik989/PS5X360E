-  uint64_t blocks[RESERVE_NUM_ENTRIES / 64];
+  uint32_t generations[RESERVE_NUM_ENTRIES];
 
-  ReserveHelper() { memset(blocks, 0, sizeof(blocks)); }
+  ReserveHelper() { memset(generations, 0, sizeof(generations)); }
 };
 
