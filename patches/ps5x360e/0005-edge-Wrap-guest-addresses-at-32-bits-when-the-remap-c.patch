From acf037e198918bcb5786cf3015e0510ac1f26604 Mon Sep 17 00:00:00 2001
From: "Herman S." <429230+has207@users.noreply.github.com>
Date: Thu, 1 Oct 2026 14:30:22 +0900
Subject: [PATCH 5/5] [x64] Wrap guest addresses at 32 bits when the remap
 check is skipped

PS5X360E: ported from Xenia Edge (github.com/has207/xenia-edge) onto
Xenia Canary b083312b + PS5X360's patch. Unchanged otherwise.

The path that skips the 0xE0000000 check added the displacement in 64
bits so base + displacement did not wrap the way the guest computes it.
Form the address with a 32-bit lea, same as the remap path.

(cherry picked from commit 984f4d3a51c45382cbf33218c992cf83e1514394)
---
 src/xenia/cpu/backend/x64/x64_seq_memory.cc | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/src/xenia/cpu/backend/x64/x64_seq_memory.cc b/src/xenia/cpu/backend/x64/x64_seq_memory.cc
index e8977070e..e36a8f7ae 100644
--- a/src/xenia/cpu/backend/x64/x64_seq_memory.cc
+++ b/src/xenia/cpu/backend/x64/x64_seq_memory.cc
@@ -286,12 +286,11 @@ RegExp ComputeMemoryAddressOffset(X64Emitter& e, const T& guest,
       return e.GetMembaseReg() + e.rdx;
 
     } else {
-      // Clear the top 32 bits, as they are likely garbage.
-      // TODO(benvanik): find a way to avoid doing this.
-
-      e.mov(e.eax, guest.reg().cvt32());
+      // A 32-bit lea wraps the guest address the way the guest computes it,
+      // and clears the top 32 bits, which are likely garbage.
+      e.lea(e.eax, e.ptr[guest.reg().cvt32() + offset_const]);
     }
-    return e.GetMembaseReg() + e.rax + offset_const;
+    return e.GetMembaseReg() + e.rax;
   }
 }
 
